---
import { Image } from 'astro:assets';
import buku from '../assets/buku-hero.png';
---
<section class="hero">
  <div class="hero-bg"></div>

  <div class="section hero-inner">
    <div class="hero-intro">
      <div class="hero-sub">Bismillahirrahmanirrahim</div>
      <h1>Penerbit Luqmanulhakim</h1>
    </div>

    <div class="hero-visual">
      <Image src={buku} width={800} widths={[240, 480, 800]}
        sizes="(max-width: 767px) 75vw, 40vw"
        alt="Buku Anak Islam Belajar: Matematika, Bahasa Indonesia, dan IPAS"
        loading="eager" fetchpriority="high" class="hero-buku" />
    </div>

    <div class="hero-content">
      <p class="hero-tagline">Buku Pelajaran untuk Sekolah Islam</p>
      <div class="visi-box">
        Membangun generasi muslim Indonesia yang kuat dalam ilmu dan
        Aqidah Islamiyah, berwawasan global, dan berakhlakul karimah — bi idznillah.
      </div>
      <div class="hero-cta">
        <a href="/katalog" class="btn-utama">Lihat Katalog</a>
        <a href="https://drive.google.com/uc?export=download&id=1AcrpZAwPVfwIBoP5xfrWlOio1eQW4oB8" class="btn-sekunder">Download</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background-image: url('/images/img-bg.jpg');
    background-size: cover; background-position: center;
    filter: brightness(0.35) saturate(0.8);
    z-index: 0;
  }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(160deg, rgba(6,31,16,0.7) 0%, rgba(13,74,42,0.55) 100%);
    z-index: 1; pointer-events: none;
  }

  /* HP: satu kolom, buku kecil di atas judul, semua rata tengah */
  .hero-inner {
    position: relative; z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }
  .hero-intro { order: 0; }
  .hero-visual { order: 1; }
  .hero-content { order: 2; }

  .hero-buku {
    display: block; height: auto;
    width: min(75vw, 380px);
    margin-inline: auto;
    filter: drop-shadow(0 12px 18px rgba(0,0,0,.45));
    animation: melayang 5s ease-in-out infinite;
  }
  @keyframes melayang { 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .hero-buku { animation: none; } }

  .hero-sub {
    font-size: 11px; color: rgba(255,255,255,0.5);
    margin: 0 0 0.5rem; font-style: italic;
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 600; line-height: 1.35;
    max-width: 620px; margin: 0 auto;
    color: #f0e8c8;
  }
  .hero-tagline {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 500; line-height: 1.35;
    max-width: 620px; margin: 0 auto 1rem;
    color: #ffffff;
  }
  .visi-box {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 12px; padding: 0.75rem 1rem;
    max-width: 600px; margin: 0 auto 1rem;
    font-size: 13px; color: rgba(255,255,255,0.88);
    line-height: 1.55; backdrop-filter: blur(4px);
  }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn-utama {
    background: rgba(255,255,255,0.18); color: #fff;
    font-size: 13px; font-weight: 600; padding: 0.75rem 1.75rem;
    border-radius: 8px; border: 1.5px solid rgba(255,255,255,0.4);
    text-decoration: none; transition: background 0.2s; backdrop-filter: blur(4px);
  }
  .btn-utama:hover { background: rgba(255,255,255,0.26); }
  .btn-sekunder {
    background: transparent; color: rgba(255,255,255,0.8);
    font-size: 13px; font-weight: 500; padding: 0.75rem 1.75rem;
    border-radius: 8px; border: 1.5px solid rgba(255,255,255,0.25);
    text-decoration: none; transition: background 0.2s;
  }
  .btn-sekunder:hover { background: rgba(255,255,255,0.08); }

  /* Tablet/PC: teks kiri, buku kanan sejajar judul. HARUS di paling bawah. */
  @media (min-width: 768px) {
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "intro visual" "content visual";
      column-gap: 2.5rem;
      row-gap: 0;
      text-align: left;
    }
    .hero-intro { grid-area: intro; }
    .hero-visual { grid-area: visual; }
    .hero-content { grid-area: content; }
    .hero-buku { width: min(100%, 400px); margin: 0 auto; }
    h1, .hero-tagline, .visi-box { margin-left: 0; margin-right: 0; }
    .hero-cta { justify-content: flex-start; }
  }
</style>