---
// Layout mandiri untuk /tes. Boleh diganti dengan layout utama luqmanulhakim.com,
// asalkan <body> (atau pembungkus halaman) diberi class "tes-root".
import '../styles/tes-tokens.css';
import '../styles/tes.css';
import { SITUS } from '../../lib/teks';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Uji kompetensi guru SDIT: IPAS, Matematika, dan Bahasa Indonesia terintegrasi Islam, per kelas. Gratis, hasil bisa dibagikan.', noindex = false } = Astro.props;
const ogImage = new URL('/tes/og-umum.png', Astro.site).toString();
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" />
  </head>
  <body class="tes-root" style="margin:0">
    <header class="tes-head">
      <a href="/tes" aria-label={`${SITUS.nama} — beranda`}>
        <img src="/tes/logo-penerbit.png" alt={SITUS.penerbit} onerror="this.remove()" />
        <span>{SITUS.nama}</span>
      </a>
      <nav><a href="https://luqmanulhakim.com/katalog/">{SITUS.tautanBuku}</a></nav>
    </header>
    <slot />
    <footer class="tes-foot">{SITUS.footer}</footer>
  </body>
</html>
