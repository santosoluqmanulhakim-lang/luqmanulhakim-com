    .kelas-title-wrap { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
  }
</style>

<script>
  // Accordion
  document.querySelectorAll('[data-toggle]').forEach(header => {
    header.addEventListener('click', () => {
      const body = header.nextElementSibling as HTMLElement;
      const isOpen = header.classList.contains('open');
      header.classList.toggle('open', !isOpen);
      body.classList.toggle('open', !isOpen);
      const arrow = header.querySelector('.kelas-arrow') as HTMLElement;
      if (arrow) arrow.textContent = isOpen ? '▼' : '▲';
    });
  });

  // Modal
  const overlay = document.getElementById('modalOverlay')!;
  const modalClose = document.getElementById('modalClose')!;
  const tabDetail = document.getElementById('tabDetail')!;
  const tabSampel = document.getElementById('tabSampel')!;
  const panelDetail = document.getElementById('panelDetail')!;
  const panelSampel = document.getElementById('panelSampel')!;
  const sampleImages = [...document.querySelectorAll<HTMLImageElement>('.sample-image')];
  const sampleEmpty = document.getElementById('sampleEmpty')!;
  const sampleCaption = document.getElementById('sampleCaption')!;
  const sampleLightbox = document.getElementById('sampleLightbox')!;
  const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightboxClose')!;
  let activeTrigger: HTMLElement | null = null;

  function showPage(page: 'detail' | 'sample') {
    const showDetail = page === 'detail';
    panelDetail.hidden = !showDetail;
    panelSampel.hidden = showDetail;
    tabDetail.classList.toggle('active', showDetail);
    tabSampel.classList.toggle('active', !showDetail);
    tabDetail.setAttribute('aria-selected', String(showDetail));
    tabSampel.setAttribute('aria-selected', String(!showDetail));
  }

  function openModal(btn: HTMLElement) {
    activeTrigger = btn;
    (document.getElementById('modalMapel') as HTMLElement).textContent = btn.dataset.mapel || '';
    (document.getElementById('modalJudul') as HTMLElement).textContent = btn.dataset.judul || '';
    (document.getElementById('modalMeta') as HTMLElement).textContent = `${btn.dataset.kelas} · ${btn.dataset.sem}`;
    (document.getElementById('modalDesc') as HTMLElement).textContent = btn.dataset.desc || '';

    sampleEmpty.hidden = false;
    sampleCaption.hidden = true;
    const sampleBase = btn.dataset.sampleBase || '';
    sampleImages.forEach((image, index) => {
      image.hidden = true;
      image.alt = `Contoh halaman ${index + 1} — ${btn.dataset.judul || 'buku'}`;
      image.onload = () => {
        image.hidden = false;
        sampleEmpty.hidden = true;
        sampleCaption.hidden = false;
      };
      image.onerror = () => {
        image.hidden = true;
        if (sampleImages.every(sample => sample.hidden)) sampleEmpty.hidden = false;
      };
      image.src = `/samples/${sampleBase}-${index + 1}.webp`;
    });

    showPage('detail');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    modalClose.focus();
  }

  function closeModal() {
    sampleLightbox.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    activeTrigger?.focus();
  }

  document.querySelectorAll('.btn-detail').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn as HTMLElement));
  });
  document.querySelectorAll('.buku-card').forEach(card => {
    card.addEventListener('click', event => {
      if ((event.target as Element).closest('.btn-detail')) return;
      const detailButton = card.querySelector('.btn-detail');
      if (detailButton) openModal(detailButton as HTMLElement);
    });
  });
  modalClose.addEventListener('click', closeModal);
  tabDetail.addEventListener('click', () => showPage('detail'));
  tabSampel.addEventListener('click', () => showPage('sample'));
  sampleImages.forEach(image => {
    image.addEventListener('click', () => {
      lightboxImage.src = image.src;
      lightboxImage.alt = image.alt;
      sampleLightbox.classList.add('open');
    });
  });
  lightboxClose.addEventListener('click', () => sampleLightbox.classList.remove('open'));
  sampleLightbox.addEventListener('click', event => {
    if (event.target === sampleLightbox) sampleLightbox.classList.remove('open');
  });
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (sampleLightbox.classList.contains('open')) sampleLightbox.classList.remove('open');
      else if (overlay.classList.contains('open')) closeModal();
    }
  });
</script>