---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Kritik & Saran — Penerbit Luqmanulhakim"
  description="Sampaikan kritik, saran, dan masukan Anda untuk perbaikan buku-buku Penerbit Luqmanulhakim."
>
  <Header />
  <main class="page-container">
    <div class="card">
      <div class="card__band"></div>

      <div class="card__body">
        <h1>Kritik, Saran &amp; Masukan</h1>
        <p class="subtitle">
          Untuk perbaikan buku-buku Penerbit Luqmanulhakim. Baarokallohu fiikum atas kepedulian Anda.
        </p>

        <form id="feedbackForm">
          <div class="field">
            <label for="nama">Nama <span class="req">*</span></label>
            <input type="text" id="nama" name="nama" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="hp">No. HP / WhatsApp</label>
            <input type="tel" id="hp" name="hp" autocomplete="tel" placeholder="08xxxxxxxxxx (opsional)" />
          </div>

          <div class="field">
            <label for="buku">Judul Buku &amp; Halaman <span class="req">*</span></label>
            <input type="text" id="buku" name="buku" required placeholder="Contoh: IPAS Kelas 1, hal. 24" />
          </div>

          <div class="field">
            <label for="alasan">Alasan Masukan <span class="req">*</span></label>
            <textarea id="alasan" name="alasan" required placeholder="Apa yang menjadi perhatian atau kekhawatiran Anda?"></textarea>
          </div>

          <div class="field">
            <label for="saran">Masukan / Saran</label>
            <textarea id="saran" name="saran" placeholder="Usulan perbaikan (opsional)"></textarea>
            <div class="hint">Boleh dikosongkan jika hanya ingin menyampaikan pertanyaan/perhatian.</div>
          </div>

          <button type="submit" id="submitBtn">Kirim Masukan</button>
          <div id="statusMsg" class="status"></div>
        </form>

        <div class="footer-note">
          Masukan Anda akan kami baca dan bahas untuk perbaikan buku.
        </div>
      </div>
    </div>

    <!-- Modal terima kasih -->
    <div id="thanksModal" class="modal-overlay">
      <div class="modal">
        <div class="modal__icon">&#10003;</div>
        <h2>Jazakumullahu Khoiron</h2>
        <p>
          Terima kasih atas perhatian dan kontribusinya. Semoga bermanfaat. Baarokallohu fiikum.
        </p>
        <button type="button" id="closeModalBtn">Tutup</button>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Salin URL Web App hasil deploy Apps Script Anda ke sini
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwmy_UiSuQNF6dkwQm-w8KRj8S1-AInSggJjzSIzr0FJ5_QHR-JAQupiR2annzPQAUE/exec";

  const form = document.getElementById('feedbackForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const status = document.getElementById('statusMsg') as HTMLDivElement;
  const modal = document.getElementById('thanksModal') as HTMLDivElement;
  const closeModalBtn = document.getElementById('closeModalBtn') as HTMLButtonElement;

  function showStatus(kind: 'ok' | 'err', message: string) {
    status.style.display = 'block';
    status.textContent = message;
    status.className = kind === 'ok' ? 'status status--ok' : 'status status--err';
  }

  function openModal() {
    modal.classList.add('open');
  }

  function closeModal() {
    modal.classList.remove('open');
  }

  closeModalBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', function (e) {
    e.preventDefault();
    status.style.display = 'none';

    const data = new FormData(form);
    btn.disabled = true;
    btn.textContent = 'Mengirim...';

    fetch(SCRIPT_URL, { method: 'POST', body: data })
      .then((res) => res.json())
      .then((res) => {
        if (res && res.result === 'success') {
          form.reset();
          openModal();
        } else {
          throw new Error((res && res.error) || 'Gagal mengirim');
        }
      })
      .catch((err) => {
        showStatus('err', 'Maaf, terjadi kendala saat mengirim. Silakan coba lagi. (' + err.message + ')');
      })
      .finally(() => {
        btn.disabled = false;
        btn.textContent = 'Kirim Masukan';
      });
  });
</script>

<style is:global>
  :root {
    --ink: #1c2b26;
    --paper: #f7f3ea;
    --emerald: #1f4d3f;
    --emerald-dark: #153c31;
    --gold: #b6862c;
    --line: #d8cfb8;
    --error: #a13a2f;
  }

  .page-container {
    min-height: 80vh;
    background: var(--paper);
    padding: 40px 16px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* Menetralkan garis divider bawaan Layout.astro */
  main > div + div {
    border-top: none !important;
  }

  .card {
    width: 100%;
    max-width: 560px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(28,43,38,0.04);
    overflow: hidden;
  }

  .card__band {
    height: 6px;
    background: linear-gradient(90deg, var(--emerald) 0%, var(--gold) 100%);
  }

  .card__body {
    padding: 32px 28px;
  }

  .card__body h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.6rem;
    color: var(--emerald-dark);
    margin: 0 0 6px;
  }

  .subtitle {
    margin: 0 0 24px;
    color: #5c6b64;
    font-size: 0.95rem;
  }

  .field {
    margin-bottom: 18px;
  }

  label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--emerald-dark);
    margin-bottom: 6px;
  }

  .req {
    color: var(--error);
    font-weight: 400;
  }

  input[type="text"],
  input[type="tel"],
  textarea {
    width: 100%;
    font-family: inherit;
    font-size: 0.98rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 10px 12px;
    outline: none;
    transition: border-color .15s ease, background .15s ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--emerald);
    background: #ffffff;
  }

  textarea {
    resize: vertical;
    min-height: 90px;
  }

  .hint {
    font-size: 0.8rem;
    color: #8a9089;
    margin-top: 4px;
  }

  #submitBtn {
    width: 100%;
    background: var(--emerald);
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 2px;
    padding: 12px 20px;
    cursor: pointer;
    transition: background .15s ease;
    margin-top: 8px;
  }

  #submitBtn:hover {
    background: var(--emerald-dark);
  }

  #submitBtn:disabled {
    background: #9aa8a1;
    cursor: not-allowed;
  }

  .status {
    margin-top: 16px;
    font-size: 0.9rem;
    padding: 12px 14px;
    border-radius: 2px;
    display: none;
  }

  .status--ok {
    background: #eef5f0;
    color: var(--emerald-dark);
    border: 1px solid #bcd6c6;
  }

  .status--err {
    background: #fbeeec;
    color: var(--error);
    border: 1px solid #e7c2ba;
  }

  .footer-note {
    text-align: center;
    font-size: 0.78rem;
    color: #9aa199;
    margin-top: 18px;
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(21, 60, 49, 0.45);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 100;
  }

  .modal-overlay.open {
    display: flex;
  }

  .modal {
    background: #ffffff;
    width: 100%;
    max-width: 400px;
    border-radius: 2px;
    border-top: 5px solid var(--gold);
    padding: 32px 28px 26px;
    text-align: center;
    box-shadow: 0 12px 32px rgba(21, 60, 49, 0.25);
  }

  .modal__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #eef5f0;
    color: var(--emerald);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 1.4rem;
  }

  .modal h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--emerald-dark);
    margin: 0 0 10px;
  }

  .modal p {
    font-size: 0.95rem;
    color: #4a5650;
    margin: 0 0 22px;
    line-height: 1.6;
  }

  #closeModalBtn {
    width: 100%;
    background: var(--emerald);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 2px;
    padding: 12px 20px;
    cursor: pointer;
  }
</style>