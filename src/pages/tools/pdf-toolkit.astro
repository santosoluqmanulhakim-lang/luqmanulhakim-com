async function addJoinFiles(files){
  hideErr('err-join');
  for(const f of files){if(!f.name.toLowerCase().endsWith('.pdf')){showErr('err-join',`"${f.name}" bukan PDF, dilewati.`);continue}
    const buf=await f.arrayBuffer();let pageCount=0;
    try{const d=await PDFLib.PDFDocument.load(new Uint8Array(buf),{ignoreEncryption:true});pageCount=d.getPageCount()}catch(e){}
    joinFiles.push({file:f,buf:buf.slice(),pageCount,range:''});}
