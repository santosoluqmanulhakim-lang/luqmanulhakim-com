---
// src/pages/tools/pdf-toolkit.astro
import Layout from '../../layouts/Layout.astro';
const title = "PowerPDF Toolkit — 9 Tools PDF dalam Satu Halaman";
const description = "Split, join, sisipkan, rotate, kompres, watermark, PDF ke gambar, gambar ke PDF, dan kompres gambar. Semua berjalan di browser tanpa upload ke server.";
---
<Layout title={title} description={description}>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js" is:inline></script>

<!-- TOPBAR -->
<header class="lq-nav">
  <div class="lq-nav-inner">
    <a href="/" class="lq-brand">
      <span class="lq-logo">📚</span>
      <div><div class="lq-name">Luqmanulhakim</div><div class="lq-tagline">Penerbit Pendidikan Islam</div></div>
    </a>
    <nav class="lq-links">
      <a href="/katalog">Katalog</a>
      <a href="/tools" class="lq-active">Tools</a>
      <a href="/kontak">Kontak</a>
    </nav>
  </div>
</header>
<div class="lq-bc"><div class="lq-bc-inner">
  <a href="/">Beranda</a><span>›</span><a href="/tools">Tools</a><span>›</span><span>PowerPDF Toolkit</span>
</div></div>

<div class="toolkit-root">


<!-- ══════════════════════ SIDEBAR ══════════════════════ -->
<nav class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-text">Power<span>PDF</span></div>
    <div class="logo-sub">Toolkit v2.0</div>
  </div>
  <div class="sidebar-section">PDF</div>
  <div class="nav-item active" data-panel="split"><span class="nav-ico">✂️</span><span>Split PDF</span></div>
  <div class="nav-item" data-panel="join"><span class="nav-ico">🔗</span><span>Join PDF</span></div>
  <div class="nav-item" data-panel="insert"><span class="nav-ico">➕</span><span>Sisipkan Halaman</span></div>
  <div class="nav-item" data-panel="rotate"><span class="nav-ico">🔄</span><span>Rotate & Reorder</span></div>
  <div class="nav-item" data-panel="compress"><span class="nav-ico">📦</span><span>Kompres PDF</span></div>
  <div class="nav-item" data-panel="watermark"><span class="nav-ico">💧</span><span>Watermark</span></div>
  <div class="sidebar-section">Gambar</div>
  <div class="nav-item" data-panel="pdf2img"><span class="nav-ico">🖼</span><span>PDF → Gambar</span></div>
  <div class="nav-item" data-panel="img2pdf"><span class="nav-ico">📄</span><span>Gambar → PDF</span></div>
  <div class="nav-item" data-panel="cimg"><span class="nav-ico">⚡</span><span>Kompres Gambar</span></div>
  <div class="sidebar-footer">
    <div class="badge-secure">🔒 100% Lokal</div><br>
    Tidak ada upload<br>ke server
  </div>
</nav>

<main class="tk-main">

<!-- ══════════════ SPLIT ══════════════ -->
<div class="panel active" id="panel-split">
  <div class="pnl-hdr">
    <div class="pnl-eyebrow">✂️ PDF Native</div>
    <div class="pnl-title">Split PDF</div>
    <div class="pnl-sub">Pecah PDF menjadi beberapa file tanpa mengubah kualitas.</div>
  </div>
  <div class="card">
    <div class="card-title">Upload PDF</div>
    <div class="dz" id="dz-split"><input type="file" id="fi-split" accept=".pdf"><span class="dz-ico">📄</span><div class="dz-t">Drop PDF di sini</div><p class="dz-s">atau <b>klik untuk pilih file</b></p></div>
  </div>
  <div class="errbox" id="err-split"></div>
  <div class="file-summary" id="fs-split">
    <span style="font-size:24px">📄</span>
    <div style="flex:1;min-width:0"><div class="fs-name" id="fs-split-name"></div><div class="fs-info" id="fs-split-info"></div></div>
    <button class="fs-rm" id="fs-split-rm">✕ Hapus</button>
  </div>
  <div id="split-controls" style="display:none">
    <div class="card">
      <div class="card-title">Mode Split</div>
      <div class="smode-row">
        <div class="smode active" data-m="visual">🖱 Pilih Visual</div>
        <div class="smode" data-m="range">📝 Range Halaman</div>
        <div class="smode" data-m="each">📑 Tiap Halaman</div>
        <div class="smode" data-m="n">🔢 Per-N Halaman</div>
      </div>
      <div id="mode-visual">
        <div class="toolbar">
          <span class="tlbl">Pilih:</span>
          <button class="tb" id="sel-all">Semua</button><button class="tb" id="sel-none">Hapus</button>
          <button class="tb" id="sel-odd">Ganjil</button><button class="tb" id="sel-even">Genap</button>
          <button class="tb" id="sel-inv">Balik</button>
          <span class="sel-count" id="sel-count">0 dipilih</span>
        </div>
        <div class="pg-grid" id="pg-grid"></div>
        <p class="hint">Halaman terpilih → 1 file. Sisanya → file kedua (jika ada).</p>
      </div>
      <div id="mode-range" style="display:none">
        <input class="range-inp" id="range-inp" type="text" placeholder="Contoh: 1-3, 5, 7-9">
        <div class="hint">Gunakan strip untuk range, koma sebagai pemisah. Contoh: <code>1-3</code> · <code>1-3,7-9</code></div>
        <label style="display:flex;align-items:center;gap:8px;margin-top:10px;font-size:12px;cursor:pointer">
          <input type="checkbox" id="range-multi" checked> Tiap grup jadi file terpisah
        </label>
      </div>
      <div id="mode-each" style="display:none">
        <div class="notice">📑 Setiap halaman jadi file PDF sendiri. Total: <strong id="each-n">—</strong> file.</div>
      </div>
      <div id="mode-n" style="display:none">
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
          <div>
            <div style="font-size:10px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px">Halaman per file</div>
            <input type="number" id="n-inp" min="1" value="2" style="width:72px;padding:8px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;font-family:'DM Mono',monospace;font-size:14px;text-align:center;outline:none;color:var(--ink)">
          </div>
          <div style="font-size:12px;color:var(--ink3);line-height:1.8" id="n-preview"></div>
        </div>
      </div>
    </div>
    <button class="btn btn-primary" id="btn-split" disabled>✂️ Split PDF</button>
  </div>
  <div class="prog" id="prog-split">
    <div class="prog-hdr"><span class="prog-lbl" id="sp-lbl">Memproses...</span><span class="prog-pct" id="sp-pct">0%</span></div>
    <div class="prog-bar"><div class="prog-fill" id="sp-fill"></div></div>
    <div class="prog-info" id="sp-info"></div>
  </div>
  <div class="result" id="res-split">
    <div class="res-top"><div class="res-badge">✅</div><div><div class="res-title">Split Berhasil</div><div class="res-sub" id="split-rsub">—</div></div></div>
    <div class="out-list" id="split-out"></div>
    <button class="btn btn-green" id="split-dlzip" style="display:none">⬇ Download Semua (ZIP)</button>
    <div class="btn-row"><button class="btn btn-ghost" id="split-reset">↩ Split Lagi</button></div>
  </div>
</div>

<!-- ══════════════ JOIN ══════════════ -->
<div class="panel" id="panel-join">
  <div class="pnl-hdr">
    <div class="pnl-eyebrow">🔗 PDF Native</div>
    <div class="pnl-title">Join PDF</div>
    <div class="pnl-sub">Gabungkan beberapa file PDF menjadi satu dokumen.</div>
  </div>
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
      <div class="card-title" style="margin:0">File PDF (seret untuk urutan)</div>
      <div class="dz-add" id="dz-add"><input type="file" id="fi-join" accept=".pdf" multiple>＋ Tambah File</div>
    </div>
    <div id="join-empty" class="join-empty">Belum ada file. Klik "Tambah File" di atas.</div>
    <div id="join-list"></div>
  </div>
  <div class="errbox" id="err-join"></div>
  <div class="card" id="join-opts" style="display:none">
    <div class="card-title">Opsi</div>
    <div class="toggle-row">
      <div><div class="toggle-name">Tambah Halaman Kosong Antar File</div><div class="toggle-desc">Sisipkan halaman kosong agar tiap file dimulai dari nomor ganjil</div></div>
      <label class="sw-label"><input type="checkbox" id="join-blank"><span class="sw-track"></span></label>
    </div>
    <div class="toggle-row">
      <div><div class="toggle-name">Hapus Metadata Sumber</div><div class="toggle-desc">Strip author, creator dari masing-masing file asal</div></div>
      <label class="sw-label"><input type="checkbox" id="join-meta"><span class="sw-track"></span></label>
    </div>
  </div>
  <button class="btn btn-primary" id="btn-join" style="display:none" disabled>🔗 Gabungkan PDF</button>
  <div class="prog" id="prog-join">
    <div class="prog-hdr"><span class="prog-lbl" id="jp-lbl">Menggabungkan...</span><span class="prog-pct" id="jp-pct">0%</span></div>
    <div class="prog-bar"><div class="prog-fill" id="jp-fill"></div></div>
    <div class="prog-info" id="jp-info"></div>
  </div>
  <div class="result" id="res-join">
    <div class="res-top"><div class="res-badge">🔗</div><div><div class="res-title">PDF Berhasil Digabung</div><div class="res-sub" id="join-rsub">—</div></div></div>
    <div class="out-list" id="join-out"></div>
    <div class="btn-row"><button class="btn btn-ghost" id="join-prev">👁 Preview</button><button class="btn btn-ghost" id="join-reset">↩ Gabung Lagi</button></div>
  </div>
</div>

<!-- ══════════════ INSERT ══════════════ -->
<div class="panel" id="panel-insert">
  <div class="pnl-hdr">
    <div class="pnl-eyebrow">➕ PDF Native</div>
    <div class="pnl-title">Sisipkan Halaman</div>
    <div class="pnl-sub">Tambah halaman kosong atau dari PDF lain ke posisi mana saja.</div>
  </div>
  <div class="card">
    <div class="card-title">1. File PDF Utama</div>
    <div class="dz" id="dz-ins-main"><input type="file" id="fi-ins-main" accept=".pdf"><span class="dz-ico">📂</span><div class="dz-t">Drop PDF Utama</div><p class="dz-s">atau <b>klik untuk pilih</b></p></div>
    <div class="file-summary" id="fs-ins-main">
      <span style="font-size:24px">📄</span>
      <div style="flex:1;min-width:0"><div class="fs-name" id="fs-ins-main-name"></div><div class="fs-info" id="fs-ins-main-info"></div></div>
      <button class="fs-rm" id="fs-ins-main-rm">✕</button>
    </div>
  </div>
  <div id="ins-controls" style="display:none">
    <div class="card">
      <div class="card-title">2. Konfigurasi Sisipan</div>
      <div class="config-row">
        <label>Posisi sisipan</label>
        <select class="sel-inp" id="ins-pos">
          <option value="before">Sebelum halaman tertentu</option>
          <option value="after" selected>Setelah halaman tertentu</option>
          <option value="start">Di awal dokumen</option>
          <option value="end">Di akhir dokumen</option>
        </select>
      </div>
      <div class="config-row" id="ins-pagenum-row">
        <label>Nomor halaman referensi (Total: <b id="ins-total-hint">—</b>)</label>
        <input type="number" class="config-inp" id="ins-pagenum" min="1" value="1">
      </div>
      <div class="config-row">
        <label>Jumlah halaman disisipkan</label>
        <input type="number" class="config-inp" id="ins-count" min="1" max="50" value="1">
      </div>
    </div>
    <div class="card">
      <div class="card-title">3. Jenis Halaman Sisipan</div>
      <div class="ins-tab-row">
        <button class="ins-tab active" data-t="blank">Halaman Kosong</button>
        <button class="ins-tab" data-t="frompdf">Dari PDF Lain</button>
      </div>
      <div class="ins-tab-pane active" id="ins-tab-blank">
        <div class="config-row">
          <label>Ukuran halaman</label>
          <select class="sel-inp" id="ins-size">
            <option value="A4">A4 (210×297mm)</option>
            <option value="A5">A5 (148×210mm)</option>
            <option value="LETTER">Letter</option>
            <option value="CUSTOM">Ikuti ukuran PDF utama</option>
          </select>
        </div>
        <div class="config-row">
          <label>Warna halaman</label>
          <div class="color-grid" id="ins-color-grid">
            <div class="color-opt selected" data-color="1,1,1" style="background:#fff" title="Putih"></div>
            <div class="color-opt" data-color="0.97,0.95,0.88" style="background:#f7f2e0" title="Krem"></div>
            <div class="color-opt" data-color="0.9,0.95,0.9" style="background:#e6f2e6" title="Hijau muda"></div>
            <div class="color-opt" data-color="0.88,0.92,0.98" style="background:#e0ebfa" title="Biru muda"></div>
            <div class="color-opt" data-color="0.98,0.95,0.88" style="background:#faf2e0" title="Kuning muda"></div>
            <div class="color-opt" data-color="0.12,0.12,0.12" style="background:#1e1e1e" title="Hitam"></div>
          </div>
        </div>
      </div>
      <div class="ins-tab-pane" id="ins-tab-frompdf">
        <div class="dz" id="dz-ins-src" style="padding:18px"><input type="file" id="fi-ins-src" accept=".pdf"><span class="dz-ico" style="font-size:22px">📋</span><div class="dz-t" style="font-size:14px">PDF Sumber Sisipan</div><p class="dz-s">Drop atau klik</p></div>
        <div class="file-summary" id="fs-ins-src" style="margin-top:8px">
          <span style="font-size:20px">📄</span>
          <div style="flex:1;min-width:0"><div class="fs-name" id="fs-ins-src-name"></div><div class="fs-info" id="fs-ins-src-info"></div></div>
          <button class="fs-rm" id="fs-ins-src-rm">✕</button>
        </div>
        <div class="config-row" style="margin-top:8px">
          <label>Rentang halaman sumber (pisah koma)</label>
          <input type="text" class="config-inp" id="ins-src-pages" placeholder="Contoh: 1,3,5-7">
          <div class="hint" style="margin-top:4px">Kosongkan = semua halaman</div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">4. Antrian Sisipan</div>
      <div id="ins-queue-list"></div>
      <div id="ins-queue-empty" style="font-size:12px;color:var(--ink3);margin-bottom:10px">Belum ada antrian. Konfigurasikan lalu klik "Tambah ke Antrian".</div>
      <button class="btn btn-ghost" id="btn-ins-add" style="width:100%;margin-bottom:8px" disabled>➕ Tambah ke Antrian</button>
    </div>
    <div class="errbox" id="err-ins"></div>
    <button class="btn btn-primary" id="btn-ins-process" disabled>⚡ Proses & Unduh PDF</button>
  </div>
  <div class="prog" id="prog-ins">
    <div class="prog-hdr"><span class="prog-lbl" id="ins-lbl">Memproses...</span><span class="prog-pct" id="ins-pct">0%</span></div>
    <div class="prog-bar"><div class="prog-fill" id="ins-fill"></div></div>
  </div>
  <div class="result" id="res-ins">
    <div class="res-top"><div class="res-badge">✅</div><div><div class="res-title">PDF Berhasil Diproses</div><div class="res-sub" id="ins-rsub">—</div></div></div>
    <div class="out-list" id="ins-out"></div>
    <div class="btn-row"><button class="btn btn-ghost" id="ins-reset">↩ Proses Lagi</button></div>
  </div>
</div>

<!-- ══════════════ ROTATE & REORDER ══════════════ -->
<div class="panel" id="panel-rotate">
  <div class="pnl-hdr">
    <div class="pnl-eyebrow">🔄 PDF Native</div>
    <div class="pnl-title">Rotate & Reorder</div>
    <div class="pnl-sub">Putar halaman individual dan ubah urutan halaman PDF dengan drag & drop.</div>
  </div>
  <div class="card">
    <div class="card-title">Upload PDF</div>
    <div class="dz" id="dz-rot"><input type="file" id="fi-rot" accept=".pdf"><span class="dz-ico">📄</span><div class="dz-t">Drop PDF di sini</div><p class="dz-s">atau <b>klik untuk pilih</b></p></div>
  </div>
  <div class="errbox" id="err-rot"></div>
  <div class="file-summary" id="fs-rot">
    <span style="font-size:24px">📄</span>
    <div style="flex:1;min-width:0"><div class="fs-name" id="fs-rot-name"></div><div class="fs-info" id="fs-rot-info"></div></div>
    <button class="fs-rm" id="fs-rot-rm">✕ Hapus</button>
  </div>
  <div id="rot-controls" style="display:none">
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div class="card-title" style="margin:0">Halaman — Seret untuk Ubah Urutan</div>
        <div style="display:flex;gap:5px">
          <button class="tb" id="rot-all-cw" title="Putar semua 90° searah jarum jam">↻ Semua</button>
          <button class="tb" id="rot-all-ccw" title="Putar semua 90° berlawanan jarum jam">↺ Semua</button>
          <button class="tb" id="rot-all-180" title="Balik semua 180°">↕ 180°</button>
        </div>
      </div>
      <div class="rot-grid" id="rot-grid"></div>
      <p class="hint">Klik ↻ atau ↺ pada tiap halaman untuk putar. Seret kartu untuk ubah urutan.</p>
    </div>
    <button class="btn btn-primary" id="btn-rot">🔄 Simpan Perubahan</button>
  </div>
  <div class="prog" id="prog-rot">
    <div class="prog-hdr"><span class="prog-lbl" id="rot-lbl">Memproses...</span><span class="prog-pct" id="rot-pct">0%</span></div>
    <div class="prog-bar"><div class="prog-fill" id="rot-fill"></div></div>
  </div>
  <div class="result" id="res-rot">
    <div class="res-top"><div class="res-badge">✅</div><div><div class="res-title">PDF Berhasil Dimodifikasi</div><div class="res-sub" id="rot-rsub">—</div></div></div>
    <div class="out-list" id="rot-out"></div>
    <div class="btn-row"><button class="btn btn-ghost" id="rot-reset">↩ Edit Lagi</button></div>
  </div>
</div>

<!-- ══════════════ COMPRESS PDF ══════════════ -->
<div class="panel" id="panel-compress">
  <div class="pnl-hdr">
    <div class="pnl-eyebrow">📦 Dua Metode</div>
    <div class="pnl-title">Kompres PDF</div>
    <div class="pnl-sub">Pilih metode kompresi sesuai kebutuhan — native untuk kualitas vektor, rasterisasi untuk ukuran terkecil.</div>
  </div>

  <!-- Pilih Metode -->
  <div class="card">
    <div class="card-title">Pilih Metode Kompresi</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:4px">

      <!-- Native -->
      <div class="cpdf-method-card sel" id="cpdf-m-native" data-method="native" style="border:2px solid var(--acc);background:var(--acc-s);border-radius:12px;padding:16px;cursor:pointer;transition:all .2s">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:20px">🧬</span>
          <div>
            <div style="font-size:13px;font-weight:700;color:var(--ink)">Native / Lossless</div>
            <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--green);background:var(--green-s);border-radius:4px;padding:1px 6px;display:inline-block;margin-top:2px">✅ Vektor Tetap Utuh</div>
          </div>
        </div>
        <div style="font-size:11px;color:var(--ink2);line-height:1.7">
          Kompresi dilakukan pada <b>struktur internal PDF</b> tanpa rendering ulang.<br>
          • Teks, font, vektor <b>100% terjaga</b><br>
          • Bisa diedit di <b>CorelDRAW, Illustrator</b><br>
          • Hapus metadata, duplikat objek, optimasi stream<br>
          • <span style="color:var(--orange)">Penghematan lebih kecil</span> (biasanya 5–30%)
        </div>
      </div>

      <!-- Rasterisasi -->
      <div class="cpdf-method-card" id="cpdf-m-raster" data-method="raster" style="border:2px solid var(--border);background:var(--bg3);border-radius:12px;padding:16px;cursor:pointer;transition:all .2s">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:20px">🖼</span>
          <div>
            <div style="font-size:13px;font-weight:700;color:var(--ink)">Rasterisasi / Lossy</div>
            <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--orange);background:var(--orange-s);border-radius:4px;padding:1px 6px;display:inline-block;margin-top:2px">⚠️ Vektor Jadi Gambar</div>
          </div>
        </div>
        <div style="font-size:11px;color:var(--ink2);line-height:1.7">
          Setiap halaman di-<b>render ulang menjadi JPEG</b> lalu dikemas kembali.<br>
          • Teks & vektor <b>tidak bisa diedit</b> lagi<br>
          • Tidak cocok untuk <b>CorelDRAW / Illustrator</b><br>
          • Cocok untuk <b>arsip, print, share</b> saja<br>
          • <span style="color:var(--green)">Penghematan jauh lebih besar</span> (bisa 50–90%)
        </div>
      </div>

    </div>
  </div>

  <!-- Upload -->
  <div class="card">
    <div class="card-title">Upload PDF</div>
    <div class="dz" id="dz-cpdf"><input type="file" id="fi-cpdf" accept=".pdf"><span class="dz-ico">📦</span><div class="dz-t">Drop PDF di sini</div><p class="dz-s">atau <b>klik untuk pilih file</b></p></div>
    <div id="fl-cpdf" style="margin-top:10px"></div>
  </div>
  <div class="errbox" id="err-cpdf"></div>

  <!-- Settings Native -->
  <div class="card" id="settings-cpdf-native" style="display:none">
