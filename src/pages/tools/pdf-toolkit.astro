    <div class="modal-ft">
      <button class="nav-btn" id="m-prev">← Prev</button>
      <span class="nav-info" id="m-nav">—</span>
      <button class="nav-btn" id="m-next">Next →</button>
    </div>
  </div>
</div>

</Layout>

<style>
/* Luqmanulhakim topbar */
.lq-nav{background:#0d4a2a;border-bottom:3px solid #c9a84c;position:sticky;top:0;z-index:200}
.lq-nav-inner{max-width:1100px;margin:0 auto;padding:0 1.5rem;height:60px;display:flex;align-items:center;justify-content:space-between}
.lq-brand{display:flex;align-items:center;gap:10px;color:white;text-decoration:none}
.lq-logo{font-size:24px}
.lq-name{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:white;letter-spacing:-.01em}
.lq-tagline{font-size:10px;color:rgba(255,255,255,.6)}
.lq-links{display:flex;align-items:center;gap:4px}
.lq-links a{padding:6px 14px;border-radius:6px;font-size:13px;font-weight:500;color:rgba(255,255,255,.75);transition:all .18s;text-decoration:none}
.lq-links a:hover{color:white;background:rgba(255,255,255,.1)}
.lq-links .lq-active{background:#c9a84c;color:#0d4a2a;font-weight:700}
.lq-bc{background:#E8F5EE;border-bottom:1px solid #d4e6da}
.lq-bc-inner{max-width:1100px;margin:0 auto;padding:8px 1.5rem;display:flex;align-items:center;gap:6px;font-size:12px;color:#4a5e52}
.lq-bc-inner a{color:#155c35;text-decoration:none}
.lq-bc-inner a:hover{color:#0d4a2a}
.lq-bc-inner span{color:#d4e6da}
/* Toolkit root wraps the full dark app */
.toolkit-root{display:flex;min-height:calc(100vh - 63px)}
.toolkit-root{--bg:#0e0f14;--bg2:#151720;--bg3:#1c1e2a;--bg4:#242636;--border:#2a2d42;--border2:#363a54;--ink:#e8eaf6;--ink2:#a8abc8;--ink3:#6b6e8e;--ink4:#444668;--acc:#7c6fcd;--acc2:#9d91e0;--acc-s:rgba(124,111,205,0.12);--acc-b:rgba(124,111,205,0.25);--green:#3dba78;--green-s:rgba(61,186,120,0.1);--red:#e05c5c;--red-s:rgba(224,92,92,0.1);--orange:#e09850;--orange-s:rgba(224,152,80,0.1);--cyan:#4ecdc4;--r:14px}
.toolkit-root{background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;font-size:14px;line-height:1.5}
/* Override sidebar top for sticky with lq-nav */
.sidebar{top:63px!important;height:calc(100vh - 63px)!important;overflow-y:auto!important}
.tk-main{margin-left:220px;flex:1;min-height:calc(100vh - 63px);min-width:0;overflow-x:hidden}
@media(max-width:768px){
  /* Sembunyikan sidebar sepenuhnya di mobile */
  .sidebar{display:none!important}
  /* Main ambil full width */
  .tk-main{margin-left:0!important;width:100%}
  .panel{padding:16px 14px 100px;max-width:100%}
  /* Bottom nav bar muncul */
  .mobile-nav{display:flex!important}
  /* Lq navbar — sembunyikan link selain aktif */
  .lq-links a:not(.lq-active){display:none}
  /* Grid adjustments */
  .mode-grid{grid-template-columns:1fr 1fr}
  .pg-grid{grid-template-columns:repeat(auto-fill,minmax(72px,1fr))}
  .rot-grid{grid-template-columns:repeat(auto-fill,minmax(80px,1fr))}
  .stat-row{flex-direction:column}
  /* Compress method cards stack */
  #panel-compress [style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important}
}


*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0e0f14;
  --bg2:#151720;
  --bg3:#1c1e2a;
  --bg4:#242636;
  --surface:#1e2030;
  --border:#2a2d42;
  --border2:#363a54;
  --ink:#e8eaf6;
  --ink2:#a8abc8;
  --ink3:#6b6e8e;
  --ink4:#444668;
  --acc:#7c6fcd;
  --acc2:#9d91e0;
  --acc-s:rgba(124,111,205,0.12);
  --acc-b:rgba(124,111,205,0.25);
  --green:#3dba78;
  --green-s:rgba(61,186,120,0.1);
  --red:#e05c5c;
  --red-s:rgba(224,92,92,0.1);
  --orange:#e09850;
  --orange-s:rgba(224,152,80,0.1);
  --cyan:#4ecdc4;
  --cyan-s:rgba(78,205,196,0.1);
  --sh:0 2px 12px rgba(0,0,0,0.4);
  --sh2:0 8px 32px rgba(0,0,0,0.5);
  --r:14px;
}

.toolkit-root *{box-sizing:border-box}

/* ── Sidebar Nav ── */

.sidebar{width:220px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;z-index:50;flex-shrink:0;overflow-y:auto}
.sidebar-logo{padding:20px 20px 16px;border-bottom:1px solid var(--border)}
.logo-text{font-family:'Syne',sans-serif;font-size:17px;font-weight:800;letter-spacing:-.03em;color:var(--ink)}
.logo-text span{color:var(--acc2)}
.logo-sub{font-size:10px;color:var(--ink3);letter-spacing:.08em;text-transform:uppercase;margin-top:2px}
.sidebar-section{padding:16px 12px 4px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink4)}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;transition:all .18s;margin:0 8px 2px;color:var(--ink2);font-size:13px;font-weight:500;border:1px solid transparent}
.nav-item:hover{background:var(--bg3);color:var(--ink)}
.nav-item.active{background:var(--acc-s);border-color:var(--acc-b);color:var(--acc2)}
.nav-ico{font-size:15px;flex-shrink:0;width:20px;text-align:center}
.sidebar-footer{margin-top:auto;padding:16px;border-top:1px solid var(--border);font-size:10px;color:var(--ink4);line-height:1.7;text-align:center}
.badge-secure{display:inline-flex;align-items:center;gap:4px;background:var(--green-s);border:1px solid rgba(61,186,120,0.2);color:var(--green);border-radius:20px;padding:3px 8px;font-size:10px;font-weight:600}

/* ── Main ── */

.panel{display:none;padding:36px 32px 80px;max-width:860px;width:100%}
.panel.active{display:block;animation:slideIn .22s ease}
@keyframes slideIn{from{opacity:0;transform:translateX(8px)}to{opacity:1;transform:translateX(0)}}

/* ── Panel Header ── */
.pnl-hdr{margin-bottom:28px}
.pnl-eyebrow{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);background:var(--acc-s);border:1px solid var(--acc-b);border-radius:20px;padding:4px 12px;display:inline-flex;align-items:center;gap:6px;margin-bottom:12px}
.pnl-title{font-family:'Syne',sans-serif;font-size:clamp(24px,3.5vw,38px);font-weight:800;letter-spacing:-.03em;line-height:1.1}
.pnl-sub{font-size:13px;color:var(--ink2);margin-top:8px;line-height:1.7;max-width:520px}

/* ── Cards ── */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:22px;margin-bottom:14px}
.card-title{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.card-title::before{content:'';display:block;width:3px;height:14px;border-radius:2px;background:var(--acc)}

/* ── Drop Zone ── */
.dz{border:2px dashed var(--border2);border-radius:12px;padding:36px 24px;text-align:center;cursor:pointer;transition:all .2s;background:var(--bg3)}
.dz:hover,.dz.over{border-color:var(--acc);background:var(--acc-s)}
.dz input[type=file]{display:none}
.dz-ico{font-size:28px;margin-bottom:10px;display:block;transition:transform .2s}
.dz:hover .dz-ico,.dz.over .dz-ico{transform:scale(1.1) translateY(-2px)}
.dz-t{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;margin-bottom:4px}
.dz-s{font-size:12px;color:var(--ink3)}
.dz-s b{color:var(--acc2)}

/* ── Errbox ── */
.errbox{background:var(--red-s);border:1px solid rgba(224,92,92,.2);border-radius:8px;padding:10px 14px;font-size:12px;color:var(--red);margin-bottom:12px;display:none}
.errbox.show{display:block}

/* ── File Summary ── */
.file-summary{display:none;align-items:center;gap:12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:14px}
.file-summary.show{display:flex}
.fs-name{font-size:12px;font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fs-info{font-size:11px;color:var(--ink3);margin-top:2px}
.fs-rm{background:none;border:1px solid var(--border);border-radius:7px;padding:5px 10px;font-family:inherit;font-size:11px;color:var(--ink3);cursor:pointer;flex-shrink:0;transition:all .2s}
.fs-rm:hover{border-color:var(--red);color:var(--red)}

/* ── File Item List ── */
.file-item{display:flex;align-items:center;gap:10px;background:var(--bg3);border:1px solid var(--border);border-radius:9px;padding:10px 14px;margin-bottom:6px}
.fi-ico{font-size:20px;flex-shrink:0}
.fi-meta{flex:1;min-width:0}
.fi-name{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fi-size{font-size:11px;color:var(--ink3)}
.fi-rm{background:none;border:none;color:var(--ink4);cursor:pointer;font-size:16px;padding:2px 6px;border-radius:4px;transition:all .15s}
.fi-rm:hover{background:var(--red-s);color:var(--red)}

/* ── Mode Tabs ── */
.smode-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.smode{padding:7px 14px;border:1px solid var(--border2);border-radius:7px;cursor:pointer;font-size:12px;font-weight:600;color:var(--ink3);background:var(--bg3);transition:all .18s;user-select:none}
.smode.active{border-color:var(--acc);color:var(--acc2);background:var(--acc-s)}

/* ── Page grid ── */
.pg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:8px;margin-bottom:12px}
.pg-card{background:var(--bg3);border:2px solid var(--border);border-radius:9px;overflow:hidden;cursor:pointer;transition:all .18s;position:relative}
.pg-card:hover{border-color:var(--border2)}
.pg-card.sel{border-color:var(--acc);background:var(--acc-s)}
.pg-card.sel::after{content:'✓';position:absolute;top:3px;right:4px;width:17px;height:17px;background:var(--acc);color:white;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;line-height:17px;text-align:center}
.pg-thumb{width:100%;aspect-ratio:3/4;background:var(--bg4);display:flex;align-items:center;justify-content:center;overflow:hidden}
.pg-thumb canvas{width:100%;height:100%;object-fit:contain;display:block}
.pg-num{font-family:'DM Mono',monospace;font-size:10px;text-align:center;padding:5px 3px;color:var(--ink3)}
.pg-card.sel .pg-num{color:var(--acc2);font-weight:700}

/* ── Toolbar ── */
.toolbar{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-bottom:12px;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:9px}
.tlbl{font-size:10px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em}
.tb{padding:4px 10px;background:var(--bg4);border:1px solid var(--border2);border-radius:6px;font-family:inherit;font-size:11px;font-weight:600;color:var(--ink2);cursor:pointer;transition:all .15s}
.tb:hover{border-color:var(--acc);color:var(--acc2)}
.sel-count{margin-left:auto;background:var(--acc-s);border:1px solid var(--acc-b);border-radius:20px;padding:3px 10px;font-size:11px;font-weight:700;color:var(--acc2);font-family:'DM Mono',monospace}

/* ── Toggle ── */
.toggle-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
.toggle-row:last-child{border-bottom:none}
.toggle-name{font-size:12px;font-weight:600;color:var(--ink)}
.toggle-desc{font-size:11px;color:var(--ink3);margin-top:1px}
.sw-label{position:relative;width:38px;height:21px;flex-shrink:0;display:inline-block;margin-left:14px}
.sw-label input{opacity:0;width:0;height:0;position:absolute}
.sw-track{position:absolute;inset:0;background:var(--bg4);border:1px solid var(--border2);border-radius:21px;cursor:pointer;transition:all .22s}
.sw-track::after{content:'';position:absolute;width:13px;height:13px;left:3px;top:3px;background:var(--ink4);border-radius:50%;transition:all .22s}
.sw-label input:checked + .sw-track{background:var(--acc-s);border-color:var(--acc)}
.sw-label input:checked + .sw-track::after{background:var(--acc2);transform:translateX(17px)}

/* ── Range input ── */
.range-inp{width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;font-family:'DM Mono',monospace;font-size:13px;color:var(--ink);outline:none;transition:border-color .2s;margin-bottom:8px}
.range-inp:focus{border-color:var(--acc);background:var(--bg4)}
.hint{font-size:11px;color:var(--ink3);line-height:1.7}
.hint code{background:var(--bg4);padding:1px 5px;border-radius:4px;font-family:'DM Mono',monospace}

/* ── Progress ── */
.prog{background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:18px;margin-bottom:14px;display:none}
.prog.show{display:block}
.prog-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.prog-lbl{font-size:12px;font-weight:600;color:var(--ink2)}
.prog-pct{font-family:'Syne',sans-serif;font-size:22px;color:var(--acc2)}
.prog-bar{height:5px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:6px}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--acc),var(--cyan));border-radius:3px;width:0;transition:width .35s ease}
.prog-info{font-size:11px;color:var(--ink3)}

/* ── Result ── */
.result{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:22px;box-shadow:var(--sh);display:none}
.result.show{display:block}
.res-top{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.res-badge{width:42px;height:42px;border-radius:11px;background:var(--green-s);border:1px solid rgba(61,186,120,.2);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.res-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700}
.res-sub{font-size:11px;color:var(--ink3);margin-top:2px}
.out-list{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.out-item{background:var(--bg3);border:1px solid var(--border);border-radius:9px;padding:10px 14px;display:flex;align-items:center;gap:10px}
.oi-meta{flex:1;min-width:0}
.oi-name{font-size:12px;font-weight:700}
.oi-info{font-size:11px;color:var(--ink3)}
.oi-dl{background:var(--acc);color:white;border:none;border-radius:7px;padding:6px 12px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:4px;transition:all .2s;flex-shrink:0}
.oi-dl:hover{filter:brightness(1.15)}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:10px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;text-decoration:none;padding:12px 18px}
.btn-primary{width:100%;padding:14px;background:linear-gradient(135deg,var(--acc),var(--acc2));color:white;margin-bottom:10px;box-shadow:0 4px 20px rgba(124,111,205,.3)}
.btn-primary:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:0 6px 24px rgba(124,111,205,.4)}
.btn-primary:disabled{opacity:.3;cursor:not-allowed;transform:none;box-shadow:none}
.btn-ghost{background:var(--bg3);color:var(--ink2);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--border2);color:var(--ink)}
.btn-green{background:linear-gradient(135deg,#2ea863,var(--green));color:white;width:100%;margin-bottom:10px;box-shadow:0 4px 16px rgba(61,186,120,.25)}
.btn-green:hover{filter:brightness(1.1)}
.btn-row{display:flex;gap:8px;flex-wrap:wrap}

/* ── Join list ── */
.join-empty{text-align:center;padding:28px;color:var(--ink4);font-size:13px;background:var(--bg3);border:2px dashed var(--border);border-radius:10px}
.ji{background:var(--bg3);border:1px solid var(--border);border-radius:9px;padding:10px 12px;display:flex;align-items:center;gap:8px;cursor:grab;transition:border-color .2s;margin-bottom:5px}
.ji.drag-over{border-color:var(--acc);background:var(--acc-s)}
.ji.dragging{opacity:.4}
.ji-drag{color:var(--ink4);font-size:16px;flex-shrink:0}
.ji-meta{flex:1;min-width:0}
.ji-name{font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ji-info{font-size:10px;color:var(--ink3)}
.ji-range{border:none;border-bottom:1px dashed var(--border2);background:none;font-family:'DM Mono',monospace;font-size:11px;color:var(--ink2);width:60px;padding:2px 4px;outline:none}
.ji-range:focus{border-bottom-color:var(--acc)}
.ji-rm{background:none;border:none;color:var(--ink4);cursor:pointer;font-size:16px;line-height:1;padding:2px 4px;border-radius:4px;transition:all .15s}
.ji-rm:hover{background:var(--red-s);color:var(--red)}
.dz-add{border:1px dashed var(--border2);border-radius:8px;padding:7px 14px;cursor:pointer;transition:all .2s;background:var(--bg3);font-size:12px;font-weight:700;color:var(--acc2);display:inline-flex;align-items:center;gap:5px}
.dz-add:hover{border-color:var(--acc);background:var(--acc-s)}
.dz-add input[type=file]{display:none}

/* ── Mode cards ── */
.mode-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-bottom:14px}
.mode-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:14px;cursor:pointer;transition:all .18s;text-align:center}
.mode-card:hover{border-color:var(--border2)}
.mode-card.sel{border-color:var(--acc);background:var(--acc-s)}
.mode-card-ico{font-size:22px;margin-bottom:6px}
.mode-card-name{font-size:11px;font-weight:700;color:var(--ink)}
.mode-card-desc{font-size:10px;color:var(--ink3);margin-top:2px}

/* ── Slider row ── */
.sl-row{margin-bottom:12px}
.sl-lbl{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:12px;font-weight:600;color:var(--ink2)}
.sl-val{font-family:'DM Mono',monospace;font-size:12px;color:var(--acc2);background:var(--acc-s);border:1px solid var(--acc-b);border-radius:5px;padding:2px 7px}
input[type=range]{width:100%;accent-color:var(--acc);height:5px;cursor:pointer}

/* ── Select ── */
.sel-inp{width:100%;padding:8px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;font-family:inherit;font-size:13px;color:var(--ink);outline:none;transition:border-color .2s;cursor:pointer;appearance:none}
.sel-inp:focus{border-color:var(--acc)}

/* ── Thumb grid ── */
.thumb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:5px;margin:10px 0;min-height:30px}
.th{position:relative;border-radius:5px;overflow:hidden;aspect-ratio:3/4;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--ink4);transition:all .2s}
.th.act{outline:2px solid var(--acc)}
.th.done{outline:2px solid var(--green)}
.th canvas{width:100%;height:100%;object-fit:cover;display:block}
.th-ck{position:absolute;bottom:2px;right:2px;width:12px;height:12px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:7px;color:white;line-height:1}
.th span{font-family:'DM Mono',monospace}

/* ── Image grid output ── */
.img-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;margin-bottom:14px}
.img-out-item{position:relative;border-radius:8px;overflow:hidden;background:var(--bg3);border:1px solid var(--border)}
.img-out-item img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}
.img-out-pg{position:absolute;top:4px;left:4px;background:rgba(0,0,0,0.7);color:white;border-radius:5px;font-size:9px;padding:2px 5px;font-family:'DM Mono',monospace}
.img-out-dl{position:absolute;bottom:4px;right:4px;background:var(--acc);border:none;border-radius:6px;padding:4px 6px;font-size:10px;cursor:pointer;color:white;transition:all .15s}
.img-out-dl:hover{filter:brightness(1.2)}

/* ── Notice ── */
.notice{background:var(--orange-s);border:1px solid rgba(224,152,80,.2);border-radius:8px;padding:10px 14px;font-size:11px;color:var(--orange);line-height:1.7;margin-bottom:12px}
.notice.ok{background:var(--green-s);border-color:rgba(61,186,120,.2);color:var(--green)}
.notice.warn{background:var(--orange-s);border-color:rgba(224,152,80,.2);color:var(--orange)}

/* ── Compress stats ── */
.stat-row{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.stat{background:var(--bg3);border:1px solid var(--border);border-radius:9px;padding:12px 16px;flex:1;min-width:90px}
.stat-lbl{font-size:10px;color:var(--ink3);margin-bottom:4px;text-transform:uppercase;letter-spacing:.06em}
.stat-val{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;color:var(--ink)}
.stat-val.green{color:var(--green)}
.sbar-wrap{margin-bottom:12px}
.sbar-lbl{font-size:11px;color:var(--ink3);margin-bottom:5px}
.sbar{height:7px;background:var(--border);border-radius:4px;overflow:hidden}
.sbar-fill{height:100%;background:linear-gradient(90deg,var(--acc),var(--green));border-radius:4px;width:0;transition:width .6s cubic-bezier(.22,.61,.36,1)}

/* ── Watermark specific ── */
.wm-color-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.wm-color-swatch{width:26px;height:26px;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:all .15s;flex-shrink:0}
.wm-color-swatch.sel{border-color:var(--acc2);transform:scale(1.12)}
.wm-preview{background:var(--bg3);border:1px solid var(--border);border-radius:9px;padding:18px;text-align:center;margin-bottom:12px;position:relative;overflow:hidden;min-height:80px;display:flex;align-items:center;justify-content:center}
.wm-preview-canvas{max-width:100%;max-height:160px;border-radius:4px}

/* ── Rotate ── */
.rot-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px;margin-bottom:12px}
.rot-card{background:var(--bg3);border:2px solid var(--border);border-radius:9px;overflow:hidden;cursor:pointer;transition:all .18s;position:relative;user-select:none}
.rot-card .pg-thumb{background:var(--bg4)}
.rot-card .pg-num{font-size:10px;padding:5px 3px}
.rot-badge{position:absolute;top:3px;left:3px;background:var(--acc);color:white;border-radius:4px;font-size:9px;padding:1px 4px;font-family:'DM Mono',monospace}
.rot-ctrls{position:absolute;top:3px;right:3px;display:flex;gap:2px}
.rot-btn{background:rgba(0,0,0,.65);border:none;border-radius:4px;color:white;width:18px;height:18px;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s}
.rot-btn:hover{background:var(--acc)}

/* ── Modal ── */
.modal-bg{position:fixed;inset:0;background:rgba(14,15,20,.85);backdrop-filter:blur(10px);z-index:200;display:none;align-items:center;justify-content:center;padding:16px}
.modal-bg.open{display:flex}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:18px;box-shadow:0 24px 60px rgba(0,0,0,.6);width:100%;max-width:680px;max-height:92vh;display:flex;flex-direction:column;overflow:hidden}
.modal-hdr{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-ttl{font-family:'Syne',sans-serif;font-size:16px;font-weight:700}
.modal-x{background:var(--bg3);border:1px solid var(--border);border-radius:7px;padding:5px 12px;font-family:inherit;font-size:12px;color:var(--ink2);cursor:pointer;transition:all .15s}
.modal-x:hover{border-color:var(--red);color:var(--red)}
.modal-body{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px;align-items:center}
.mpw{background:var(--bg3);border-radius:6px;overflow:hidden;width:100%;max-width:540px;box-shadow:var(--sh2)}
.mpw canvas{display:block;width:100%;height:auto}
.modal-ft{border-top:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;justify-content:center;gap:12px;flex-shrink:0}
.nav-btn{background:var(--bg3);border:1px solid var(--border);border-radius:7px;padding:6px 14px;font-family:inherit;font-size:12px;color:var(--ink2);cursor:pointer;transition:all .2s}
.nav-btn:hover:not(:disabled){border-color:var(--acc);color:var(--acc2)}
.nav-btn:disabled{opacity:.3;cursor:not-allowed}
.nav-info{font-family:'DM Mono',monospace;font-size:14px;color:var(--ink3);min-width:60px;text-align:center}

/* ── Inserter specific ── */
.ins-tab-row{display:flex;gap:6px;margin-bottom:12px}
.ins-tab{padding:7px 14px;border:1px solid var(--border2);border-radius:7px;cursor:pointer;font-size:12px;font-weight:600;color:var(--ink3);background:var(--bg3);transition:all .18s}
.ins-tab.active{border-color:var(--acc);color:var(--acc2);background:var(--acc-s)}
.ins-tab-pane{display:none}
.ins-tab-pane.active{display:block}
.config-row{margin-bottom:10px}
.config-row label{display:block;font-size:11px;font-weight:600;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
.config-inp{width:100%;padding:8px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;font-family:inherit;font-size:13px;color:var(--ink);outline:none;transition:border .2s}
.config-inp:focus{border-color:var(--acc)}
.ins-queue-item{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:9px 12px;display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;font-size:12px}
.ins-q-desc{flex:1;color:var(--ink2)}
.ins-q-rm{background:none;border:none;color:var(--ink4);cursor:pointer;font-size:14px;transition:color .15s}
.ins-q-rm:hover{color:var(--red)}
.color-grid{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}
.color-opt{width:24px;height:24px;border-radius:5px;cursor:pointer;border:2px solid transparent;transition:all .15s}
.color-opt.selected{border-color:var(--acc2);transform:scale(1.15)}
.color-opt:hover{transform:scale(1.1)}

/* ── Footer ── */
footer{text-align:center;padding:24px 0 0;font-size:10px;color:var(--ink4);line-height:1.8}



/* Mobile bottom nav — hidden by default, shown on mobile */
.mobile-nav{
  display:none;
  position:fixed;
  bottom:0;left:0;right:0;
  background:var(--bg2);
  border-top:1px solid var(--border);
  z-index:100;
  padding:0;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}
.mobile-nav::-webkit-scrollbar{display:none}
.mobile-nav-inner{
  display:flex;
  align-items:stretch;
  min-width:max-content;
  padding:0 4px;
}
.mobile-nav-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:2px;
  padding:8px 12px;
  cursor:pointer;
  color:var(--ink3);
  font-size:9px;
  font-weight:600;
  letter-spacing:.04em;
  text-transform:uppercase;
  border-top:2px solid transparent;
  transition:all .18s;
  min-width:60px;
  white-space:nowrap;
  font-family:'Inter',sans-serif;
}
.mobile-nav-item.active{color:var(--acc2);border-top-color:var(--acc)}
.mobile-nav-item:hover{color:var(--ink);background:var(--bg3)}
.mobile-nav-ico{font-size:18px;line-height:1}

</style>

<script>

pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const $=id=>document.getElementById(id);

// ══════════════════════════════════════════════
// UTILS
// ══════════════════════════════════════════════
function fmtB(b){if(b<1024)return b+' B';if(b<1048576)return(b/1024).toFixed(1)+' KB';return(b/1048576).toFixed(2)+' MB'}
function tick(){return new Promise(r=>requestAnimationFrame(()=>setTimeout(r,0)))}
function delay(ms){return new Promise(r=>setTimeout(r,ms))}
function setP(fillId,pctId,lblId,pct,lbl){$(fillId).style.width=pct+'%';$(pctId).textContent=pct+'%';if(lblId&&lbl!==undefined)$(lblId).textContent=lbl}
function showErr(id,m){const e=$(id);e.textContent=m;e.classList.add('show')}
function hideErr(id){$(id).classList.remove('show')}
function dlBlob(bytes,mime,name){const b=new Blob([bytes],{type:mime});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click()}
function readFileAsDataURL(f){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(f)})}
function loadImage(src){return new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=src})}

function crc32(data){let c=0xffffffff;for(let i=0;i<data.length;i++){c^=data[i];for(let j=0;j<8;j++)c=c&1?(c>>>1)^0xedb88320:(c>>>1)}return(c^0xffffffff)>>>0}
function concat(arrays){const t=arrays.reduce((s,a)=>s+a.length,0);const o=new Uint8Array(t);let off=0;for(const a of arrays){o.set(a,off);off+=a.length}return o}
function makeZip(files){
  const chunks=[],cd=[];let offset=0;
  for(const f of files){
    const name=new TextEncoder().encode(f.name);const crcVal=crc32(f.data);
    const lh=new Uint8Array(30+name.length);const lv=new DataView(lh.buffer);
    lv.setUint32(0,0x04034b50,true);lv.setUint16(4,20,true);lv.setUint32(14,crcVal,true);lv.setUint32(18,f.data.length,true);lv.setUint32(22,f.data.length,true);lv.setUint16(26,name.length,true);lh.set(name,30);
    const cde=new Uint8Array(46+name.length);const cv=new DataView(cde.buffer);
    cv.setUint32(0,0x02014b50,true);cv.setUint16(4,20,true);cv.setUint16(6,20,true);cv.setUint32(16,crcVal,true);cv.setUint32(20,f.data.length,true);cv.setUint32(24,f.data.length,true);cv.setUint16(28,name.length,true);cv.setUint32(42,offset,true);cde.set(name,46);
    cd.push(cde);chunks.push(lh,f.data);offset+=lh.length+f.data.length;
  }
  const cdBuf=concat(cd);const eocd=new Uint8Array(22);const ev=new DataView(eocd.buffer);
  ev.setUint32(0,0x06054b50,true);ev.setUint16(8,files.length,true);ev.setUint16(10,files.length,true);ev.setUint32(12,cdBuf.length,true);ev.setUint32(16,offset,true);
  return concat([...chunks,cdBuf,eocd]);
}

function makeOutItem(name,info,bytes,mime,dlName){
  const item=document.createElement('div');item.className='out-item';
  const ico=document.createElement('span');ico.textContent=mime.includes('image')?'🖼':'📄';ico.style.cssText='font-size:20px;flex-shrink:0';
  const meta=document.createElement('div');meta.className='oi-meta';
  const nm=document.createElement('div');nm.className='oi-name';nm.textContent=name;
  const inf=document.createElement('div');inf.className='oi-info';inf.textContent=info;
  meta.append(nm,inf);
  const btn=document.createElement('a');btn.className='oi-dl';btn.textContent='⬇ Download';
  btn.href=URL.createObjectURL(new Blob([bytes],{type:mime}));btn.download=dlName;
  item.append(ico,meta,btn);return item;
}

function renderFileList(listId,files,type,onRemove){
  const el=$(listId);el.innerHTML='';
  files.forEach((f,i)=>{
    const div=document.createElement('div');div.className='file-item';
    const ico=document.createElement('span');ico.className='fi-ico';ico.textContent=type==='pdf'?'📄':'🖼';
    const meta=document.createElement('div');meta.className='fi-meta';
    const name=document.createElement('div');name.className='fi-name';name.textContent=f.name;
    const size=document.createElement('div');size.className='fi-size';size.textContent=fmtB(f.size);
    const rm=document.createElement('button');rm.className='fi-rm';rm.textContent='✕';
    rm.onclick=()=>onRemove(i);
    meta.append(name,size);div.append(ico,meta,rm);el.appendChild(div);
  });
}

// ══════════════════════════════════════════════
// NAV — sidebar + mobile bottom nav sync
// ══════════════════════════════════════════════
function switchPanel(panelId){
  document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.mobile-nav-item').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('[data-panel="'+panelId+'"]').forEach(x=>x.classList.add('active'));
  const panel=$('panel-'+panelId);
  if(panel) panel.classList.add('active');
  // scroll mobile nav item into view
  const mItem=document.querySelector('.mobile-nav-item[data-panel="'+panelId+'"]');
  if(mItem) mItem.scrollIntoView({inline:'center',behavior:'smooth'});
}
document.querySelectorAll('.nav-item').forEach(n=>{
  n.addEventListener('click',()=>switchPanel(n.dataset.panel));
});
document.querySelectorAll('.mobile-nav-item').forEach(n=>{
  n.addEventListener('click',()=>switchPanel(n.dataset.panel));
});

// ══════════════════════════════════════════════
// DROP ZONE FACTORY
// ══════════════════════════════════════════════
function setupDz(dzId,fiId,cb,multiple=false){
  const dz=$(dzId),fi=$(fiId);
  dz.addEventListener('click',()=>fi.click());
  dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('over')});
  dz.addEventListener('dragleave',()=>dz.classList.remove('over'));
  dz.addEventListener('drop',e=>{e.preventDefault();dz.classList.remove('over');cb(multiple?[...e.dataTransfer.files]:[e.dataTransfer.files[0]])});
  fi.addEventListener('change',()=>{cb(multiple?[...fi.files]:[fi.files[0]]);fi.value=''});
}

// ══════════════════════════════════════════════
// MODAL
// ══════════════════════════════════════════════
let mPdf=null,mPage=1,mTotal=0;
function openModal(title){$('modal-ttl').textContent=title;$('modal-body').innerHTML='<div style="padding:40px;color:var(--ink3);font-size:13px">Memuat preview...</div>';$('modal').classList.add('open')}
function startModal(pdf){mPdf=pdf;mTotal=pdf.numPages;mPage=1;renderModalPage(1)}
async function renderModalPage(n){
  $('m-nav').textContent=`${n} / ${mTotal}`;$('m-prev').disabled=n<=1;$('m-next').disabled=n>=mTotal;
  try{
    const page=await mPdf.getPage(n);const vp=page.getViewport({scale:1.4});
    const c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;
    await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;
    const w=document.createElement('div');w.className='mpw';w.appendChild(c);
    $('modal-body').innerHTML='';$('modal-body').appendChild(w);
  }catch(e){$('modal-body').innerHTML=`<div style="padding:20px;color:var(--red)">${e.message}</div>`}
}
$('m-prev').onclick=()=>{if(mPage>1){mPage--;renderModalPage(mPage)}};
$('m-next').onclick=()=>{if(mPage<mTotal){mPage++;renderModalPage(mPage)}};
$('modal-x').onclick=()=>$('modal').classList.remove('open');
$('modal').onclick=e=>{if(e.target===$('modal'))$('modal').classList.remove('open')};

// ══════════════════════════════════════════════
// SPLIT
// ══════════════════════════════════════════════
let spFile=null,spBytes=null,spPdfJs=null,spN=0,spSelected=new Set(),spMode='visual',spOutputs=[];

setupDz('dz-split','fi-split',f=>loadSplitFile(f));
async function loadSplitFile(f){
  if(!f?.name?.toLowerCase().endsWith('.pdf')){showErr('err-split','Pilih file PDF.');return}
  hideErr('err-split');spFile=f;spSelected.clear();spOutputs=[];
  $('fs-split-name').textContent=f.name;$('fs-split-info').textContent='Memuat...';
  $('fs-split').classList.add('show');$('split-controls').style.display='';
  $('res-split').classList.remove('show');$('prog-split').classList.remove('show');$('btn-split').disabled=true;
  const buf=await f.arrayBuffer();spBytes=new Uint8Array(buf);
  spPdfJs=await pdfjsLib.getDocument({data:spBytes.slice()}).promise;spN=spPdfJs.numPages;
  $('fs-split-info').textContent=`${spN} halaman · ${fmtB(f.size)}`;$('each-n').textContent=spN;
  updateNPreview();await buildSplitGrid();$('btn-split').disabled=false;updateSelCount();
}
async function buildSplitGrid(){
  const grid=$('pg-grid');grid.innerHTML='';
  for(let i=1;i<=spN;i++){
    const card=document.createElement('div');card.className='pg-card';card.dataset.p=i;
    const thumb=document.createElement('div');thumb.className='pg-thumb';thumb.innerHTML='<span style="font-size:9px;color:var(--ink4)">…</span>';
    const num=document.createElement('div');num.className='pg-num';num.textContent='Hal '+i;
    card.append(thumb,num);card.onclick=()=>toggleSplitPage(i,card);grid.appendChild(card);
    (async()=>{try{const page=await spPdfJs.getPage(i);const vp=page.getViewport({scale:.35});const c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;thumb.innerHTML='';thumb.appendChild(c)}catch(e){}})();
    await tick();
  }
}
function toggleSplitPage(n,card){if(spSelected.has(n)){spSelected.delete(n);card.classList.remove('sel')}else{spSelected.add(n);card.classList.add('sel')};updateSelCount()}
function updateSelCount(){$('sel-count').textContent=spSelected.size+' dipilih'}
$('sel-all').onclick=()=>{for(let i=1;i<=spN;i++)spSelected.add(i);document.querySelectorAll('.pg-card').forEach(c=>c.classList.add('sel'));updateSelCount()};
$('sel-none').onclick=()=>{spSelected.clear();document.querySelectorAll('.pg-card').forEach(c=>c.classList.remove('sel'));updateSelCount()};
$('sel-odd').onclick=()=>{spSelected.clear();document.querySelectorAll('.pg-card').forEach(c=>{const p=+c.dataset.p;if(p%2===1){spSelected.add(p);c.classList.add('sel')}else c.classList.remove('sel')});updateSelCount()};
$('sel-even').onclick=()=>{spSelected.clear();document.querySelectorAll('.pg-card').forEach(c=>{const p=+c.dataset.p;if(p%2===0){spSelected.add(p);c.classList.add('sel')}else c.classList.remove('sel')});updateSelCount()};
$('sel-inv').onclick=()=>{document.querySelectorAll('.pg-card').forEach(c=>{const p=+c.dataset.p;if(spSelected.has(p)){spSelected.delete(p);c.classList.remove('sel')}else{spSelected.add(p);c.classList.add('sel')}});updateSelCount()};
document.querySelectorAll('.smode').forEach(s=>{
  s.addEventListener('click',()=>{
    document.querySelectorAll('.smode').forEach(x=>x.classList.remove('active'));s.classList.add('active');spMode=s.dataset.m;
    ['visual','range','each','n'].forEach(m=>$('mode-'+m).style.display='none');$('mode-'+spMode).style.display='';
  });
});
$('n-inp').oninput=updateNPreview;
function updateNPreview(){const n=Math.max(1,parseInt($('n-inp').value)||1);if(!spN){$('n-preview').textContent='';return}const k=Math.ceil(spN/n);const parts=[];for(let i=0;i<k;i++){const a=i*n+1,b=Math.min((i+1)*n,spN);parts.push(a===b?`${a}`:`${a}–${b}`)}$('n-preview').innerHTML=`<strong>${k} file:</strong><br>${parts.slice(0,8).join(', ')}${parts.length>8?', …':''}`}
function buildSplitGroups(){
  if(spMode==='visual'){if(!spSelected.size)return[];const sel=[...spSelected].sort((a,b)=>a-b);const unsel=[];for(let i=1;i<=spN;i++)if(!spSelected.has(i))unsel.push(i);return unsel.length?[sel,unsel]:[sel]}
  if(spMode==='each')return Array.from({length:spN},(_,i)=>[i+1]);
  if(spMode==='n'){const n=Math.max(1,parseInt($('n-inp').value)||1);const groups=[];for(let i=0;i<spN;i+=n){const g=[];for(let j=i;j<Math.min(i+n,spN);j++)g.push(j+1);groups.push(g)}return groups}
  if(spMode==='range'){const raw=$('range-inp').value.trim();if(!raw)return[];const multi=$('range-multi').checked;const groups=[];for(const p of raw.split(',')){const m=p.trim().match(/^(\d+)(?:-(\d+))?$/);if(!m)continue;const from=+m[1],to=m[2]?+m[2]:from;const g=[];for(let i=Math.max(1,from);i<=Math.min(to,spN);i++)g.push(i);if(!g.length)continue;if(multi)groups.push(g);else{if(!groups.length)groups.push([]);groups[0].push(...g)}}return groups}
  return[];
}
$('btn-split').onclick=async()=>{
  if(!spFile||!spBytes)return;const groups=buildSplitGroups();
  if(!groups.length){showErr('err-split','Tidak ada halaman dipilih.');return}
  $('btn-split').disabled=true;$('prog-split').classList.add('show');$('res-split').classList.remove('show');hideErr('err-split');spOutputs=[];
  try{
    const baseName=spFile.name.replace(/\.pdf$/i,'');
    for(let g=0;g<groups.length;g++){
      setP('sp-fill','sp-pct','sp-lbl',5+Math.round((g/groups.length)*90),`File ${g+1}/${groups.length}...`);$('sp-info').textContent='Halaman: '+groups[g].join(', ');await tick();
      const srcDoc=await PDFLib.PDFDocument.load(spBytes,{ignoreEncryption:true});const outDoc=await PDFLib.PDFDocument.create();
      const copied=await outDoc.copyPages(srcDoc,groups[g].map(p=>p-1));copied.forEach(p=>outDoc.addPage(p));
      const saved=await outDoc.save({useObjectStreams:true});
      let name;if(groups.length===1)name=`${baseName}_split.pdf`;else if(spMode==='each')name=`${baseName}_p${groups[g][0]}.pdf`;else name=`${baseName}_part${g+1}.pdf`;
      spOutputs.push({bytes:saved,name});await tick();
    }
    setP('sp-fill','sp-pct','sp-lbl',100,'Selesai!');await delay(300);
    $('split-out').innerHTML='';
    for(const out of spOutputs){const tmpDoc=await PDFLib.PDFDocument.load(out.bytes);$('split-out').appendChild(makeOutItem(out.name,`${tmpDoc.getPageCount()} halaman · ${fmtB(out.bytes.byteLength)}`,out.bytes,'application/pdf',out.name))}
