  const q=parseInt($('i2p-q').value)/100,margin=parseInt($('i2p-m').value),sizeOpt=$('i2p-size').value,oriOpt=document.querySelector('input[name=i2p-ori]:checked').value,fitPage=$('i2p-fit').checked;
  const sizes={a4:[595,842],letter:[612,792],a3:[842,1191]};
  try{
    const newDoc=await PDFLib.PDFDocument.create();
    for(let i=0;i<i2pFiles.length;i++){
      setP('i2p-pfill','i2p-ppct','i2p-plbl',5+Math.round((i/i2pFiles.length)*88),`Proses ${i+1}/${i2pFiles.length}...`);$('i2p-pinfo').textContent=i2pFiles[i].name;await tick();
      const imgData=await readFileAsDataURL(i2pFiles[i]);const img=await loadImage(imgData);
      const canvas=document.createElement('canvas');canvas.width=img.naturalWidth;canvas.height=img.naturalHeight;canvas.getContext('2d').drawImage(img,0,0);
      const mime=i2pFiles[i].type==='image/png'?'image/png':'image/jpeg';const dataUrl=canvas.toDataURL(mime,q);const b64=dataUrl.split(',')[1];const bytes=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));
      const embImg=mime==='image/jpeg'?await newDoc.embedJpg(bytes):await newDoc.embedPng(bytes);
      let pw,ph;if(sizeOpt==='auto'){pw=img.naturalWidth*.75;ph=img.naturalHeight*.75}else[pw,ph]=sizes[sizeOpt];
      let finalW=pw,finalH=ph;if(oriOpt==='landscape'&&ph>pw)[finalW,finalH]=[ph,pw];else if(oriOpt==='portrait'&&pw>ph)[finalW,finalH]=[ph,pw];else if(oriOpt==='auto'&&img.naturalWidth>img.naturalHeight&&ph>pw)[finalW,finalH]=[ph,pw];
      const page=newDoc.addPage([finalW,finalH]);const avW=finalW-margin*2*.75,avH=finalH-margin*2*.75;
      let iw,ih;if(fitPage&&sizeOpt!=='auto'){const ratio=Math.min(avW/img.naturalWidth*.75,avH/img.naturalHeight*.75);iw=img.naturalWidth*.75*ratio;ih=img.naturalHeight*.75*ratio}else{iw=img.naturalWidth*.75;ih=img.naturalHeight*.75}
      page.drawImage(embImg,{x:(finalW-iw)/2,y:(finalH-ih)/2,width:iw,height:ih});await tick();
    }
    setP('i2p-pfill','i2p-ppct','i2p-plbl',96,'Menyimpan...');const saved=await newDoc.save({useObjectStreams:true});setP('i2p-pfill','i2p-ppct','i2p-plbl',100,'Selesai!');await delay(300);
    window._i2pBytes=saved;$('i2p-out').innerHTML='';$('i2p-out').appendChild(makeOutItem('images_to_pdf.pdf',`${i2pFiles.length} halaman · ${fmtB(saved.byteLength)}`,saved,'application/pdf','images_to_pdf.pdf'));
    $('i2p-rsub').textContent=`${i2pFiles.length} gambar → ${fmtB(saved.byteLength)}`;$('prog-i2p').classList.remove('show');$('res-i2p').classList.add('show');$('btn-i2p').disabled=false;
  }catch(e){showErr('err-i2p','Gagal: '+e.message);$('prog-i2p').classList.remove('show');$('btn-i2p').disabled=false}
};
$('i2p-prev').onclick=async()=>{if(!window._i2pBytes)return;openModal('Preview PDF dari Gambar');const pdfjs=await pdfjsLib.getDocument({data:new Uint8Array(window._i2pBytes)}).promise;startModal(pdfjs)};
$('i2p-reset').onclick=()=>{i2pFiles=[];window._i2pBytes=null;$('fl-i2p').innerHTML='';$('settings-i2p').style.display='none';$('btn-i2p').style.display='none';$('notice-i2p').style.display='none';$('prog-i2p').classList.remove('show');$('res-i2p').classList.remove('show')};

// ══════════════════════════════════════════════
// COMPRESS IMAGE
// ══════════════════════════════════════════════
let cimgFiles=[],cimgResults=[];
$('cimg-q').oninput=()=>$('cimg-qval').textContent=$('cimg-q').value+'%';
$('cimg-w').oninput=()=>$('cimg-wval').textContent=$('cimg-w').value==0?'bebas':$('cimg-w').value;
$('cimg-h').oninput=()=>$('cimg-hval').textContent=$('cimg-h').value==0?'bebas':$('cimg-h').value;
setupDz('dz-cimg','fi-cimg',files=>{
  hideErr('err-cimg');const valid=(Array.isArray(files)?files:[files]).filter(f=>f&&f.type.startsWith('image/'));
  if(!valid.length){showErr('err-cimg','Pilih file gambar.');return}
  cimgFiles=[...cimgFiles,...valid];cimgResults=[];
  renderFileList('fl-cimg',cimgFiles,'img',i=>{cimgFiles.splice(i,1);renderFileList('fl-cimg',cimgFiles,'img',arguments.callee);if(!cimgFiles.length){$('settings-cimg').style.display='none';$('btn-cimg').style.display='none'}});
  $('settings-cimg').style.display='';$('btn-cimg').style.display='flex';$('btn-cimg').disabled=false;$('res-cimg').classList.remove('show');
},true);
$('btn-cimg').onclick=async()=>{
  if(!cimgFiles.length)return;$('btn-cimg').disabled=true;cimgResults=[];$('prog-cimg').classList.add('show');$('res-cimg').classList.remove('show');
  const q=parseInt($('cimg-q').value)/100,fmtOpt=document.querySelector('input[name=cimg-fmt]:checked').value,maxW=parseInt($('cimg-w').value)||0,maxH=parseInt($('cimg-h').value)||0;
  try{
    for(let i=0;i<cimgFiles.length;i++){
      setP('cimg-pfill','cimg-ppct','cimg-plbl',5+Math.round((i/cimgFiles.length)*90),`Kompres ${i+1}/${cimgFiles.length}`);$('cimg-pinfo').textContent=cimgFiles[i].name;await tick();
      const imgUrl=await readFileAsDataURL(cimgFiles[i]);const img=await loadImage(imgUrl);
      let w=img.naturalWidth,h=img.naturalHeight;if(maxW&&w>maxW){const r=maxW/w;w=maxW;h=Math.round(h*r)}if(maxH&&h>maxH){const r=maxH/h;h=maxH;w=Math.round(w*r)}
      const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;canvas.getContext('2d').drawImage(img,0,0,w,h);
      let outFmt=fmtOpt==='same'?cimgFiles[i].type:('image/'+fmtOpt);if(outFmt==='image/jpg')outFmt='image/jpeg';const ext=outFmt.split('/')[1].replace('jpeg','jpg');
      const dataUrl=canvas.toDataURL(outFmt,q);const bytes=Uint8Array.from(atob(dataUrl.split(',')[1]),c=>c.charCodeAt(0));
      cimgResults.push({name:cimgFiles[i].name.replace(/\.[^.]+$/,'.')+ext,orig:cimgFiles[i].size,bytes,dataUrl,mime:outFmt,ext});await tick();
    }
    setP('cimg-pfill','cimg-ppct','cimg-plbl',100,'Selesai!');await delay(300);
    $('cimg-grid').innerHTML='';let totalOrig=0,totalNew=0;
    for(const r of cimgResults){totalOrig+=r.orig;totalNew+=r.bytes.length;const div=document.createElement('div');div.className='img-out-item';const el=document.createElement('img');el.src=r.dataUrl;const pg=document.createElement('span');pg.className='img-out-pg';const saved=((r.orig-r.bytes.length)/r.orig*100).toFixed(0);pg.textContent=`-${saved}%`;const btn=document.createElement('button');btn.className='img-out-dl';btn.textContent='⬇';btn.onclick=()=>dlBlob(r.bytes,r.mime,r.name);div.append(el,pg,btn);$('cimg-grid').appendChild(div)}
    const totalSaved=((totalOrig-totalNew)/totalOrig*100).toFixed(1);$('cimg-rsub').textContent=`${cimgFiles.length} gambar · ${fmtB(totalOrig)} → ${fmtB(totalNew)} · Hemat ${totalSaved}%`;
    $('prog-cimg').classList.remove('show');$('res-cimg').classList.add('show');$('btn-cimg').disabled=false;
  }catch(e){showErr('err-cimg','Gagal: '+e.message);$('prog-cimg').classList.remove('show');$('btn-cimg').disabled=false}
};
$('cimg-dlall').onclick=()=>{if(cimgResults.length)dlBlob(makeZip(cimgResults.map(r=>({name:r.name,data:r.bytes}))),'application/zip','compressed_images.zip')};
$('cimg-reset').onclick=()=>{cimgFiles=[];cimgResults=[];$('fl-cimg').innerHTML='';$('settings-cimg').style.display='none';$('btn-cimg').style.display='none';$('prog-cimg').classList.remove('show');$('res-cimg').classList.remove('show')};

</script>