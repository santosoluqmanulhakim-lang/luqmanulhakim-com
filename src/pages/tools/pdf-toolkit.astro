let rotFile=null,rotBytes=null,rotPdfJs=null,rotN=0;
let rotState=[]; // [{origIdx, rotation}]

setupDz('dz-rot','fi-rot',f=>loadRotFile(Array.isArray(f)?f[0]:f));
async function loadRotFile(f){
  if(!f?.name?.toLowerCase().endsWith('.pdf')){showErr('err-rot','Pilih file PDF.');return}
  hideErr('err-rot');rotFile=f;
  $('fs-rot-name').textContent=f.name;$('fs-rot-info').textContent='Memuat...';$('fs-rot').classList.add('show');$('rot-controls').style.display='';
  $('res-rot').classList.remove('show');$('prog-rot').classList.remove('show');
  const buf=await f.arrayBuffer();rotBytes=new Uint8Array(buf);
  rotPdfJs=await pdfjsLib.getDocument({data:rotBytes.slice()}).promise;rotN=rotPdfJs.numPages;
  rotState=Array.from({length:rotN},(_,i)=>({origIdx:i,rotation:0}));
  $('fs-rot-info').textContent=`${rotN} halaman · ${fmtB(f.size)}`;
  await buildRotGrid();
}
async function buildRotGrid(){
  const grid=$('rot-grid');grid.innerHTML='';
  for(let i=0;i<rotState.length;i++){
    const s=rotState[i];
    const card=document.createElement('div');card.className='rot-card';card.dataset.si=i;card.draggable=true;
    const thumb=document.createElement('div');thumb.className='pg-thumb';thumb.innerHTML='<span style="font-size:9px;color:var(--ink4)">…</span>';
    const num=document.createElement('div');num.className='pg-num';num.textContent=`Hal ${s.origIdx+1}`;
    const ctrls=document.createElement('div');ctrls.className='rot-ctrls';
    const ccw=document.createElement('button');ccw.className='rot-btn';ccw.textContent='↺';ccw.title='Putar kiri';
    const cw=document.createElement('button');cw.className='rot-btn';cw.textContent='↻';cw.title='Putar kanan';
    const badge=document.createElement('div');badge.className='rot-badge';badge.id='rot-badge-'+i;badge.textContent=s.rotation?s.rotation+'°':'';badge.style.display=s.rotation?'':'none';
    ccw.onclick=e=>{e.stopPropagation();rotState[i].rotation=(rotState[i].rotation-90+360)%360;updateRotBadge(i)};
    cw.onclick=e=>{e.stopPropagation();rotState[i].rotation=(rotState[i].rotation+90)%360;updateRotBadge(i)};
    ctrls.append(ccw,cw);card.append(thumb,badge,ctrls,num);grid.appendChild(card);
    // drag reorder
    card.ondragstart=e=>{e.dataTransfer.setData('text/plain',i);card.style.opacity='.4'};
    card.ondragend=()=>card.style.opacity='1';
    card.ondragover=e=>{e.preventDefault();card.style.outline='2px solid var(--acc)'};
    card.ondragleave=()=>card.style.outline='';
    card.ondrop=e=>{e.preventDefault();card.style.outline='';const from=parseInt(e.dataTransfer.getData('text/plain'));if(from===i)return;const moved=rotState.splice(from,1)[0];rotState.splice(i,0,moved);buildRotGrid()};
    (async()=>{
      try{
        const page=await rotPdfJs.getPage(s.origIdx+1);const vp=page.getViewport({scale:.35});
        const c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;
        await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;thumb.innerHTML='';thumb.appendChild(c);
      }catch(e){}
    })();
    await tick();
  }
}
function updateRotBadge(i){const badge=$('rot-badge-'+i);if(badge){badge.textContent=rotState[i].rotation?rotState[i].rotation+'°':'';badge.style.display=rotState[i].rotation?'':'none'}}
$('rot-all-cw').onclick=()=>{rotState.forEach((_,i)=>{rotState[i].rotation=(rotState[i].rotation+90)%360;updateRotBadge(i)})};
$('rot-all-ccw').onclick=()=>{rotState.forEach((_,i)=>{rotState[i].rotation=(rotState[i].rotation-90+360)%360;updateRotBadge(i)})};
$('rot-all-180').onclick=()=>{rotState.forEach((_,i)=>{rotState[i].rotation=(rotState[i].rotation+180)%360;updateRotBadge(i)})};
$('btn-rot').onclick=async()=>{
  if(!rotFile||!rotBytes)return;
  $('btn-rot').disabled=true;$('prog-rot').classList.add('show');$('res-rot').classList.remove('show');
  try{
    setP('rot-fill','rot-pct','rot-lbl',5,'Memuat...');
    const srcDoc=await PDFLib.PDFDocument.load(rotBytes,{ignoreEncryption:true});const outDoc=await PDFLib.PDFDocument.create();
    for(let i=0;i<rotState.length;i++){
      setP('rot-fill','rot-pct','rot-lbl',10+Math.round((i/rotState.length)*85),`Halaman ${i+1}/${rotState.length}`);await tick();
      const [pg]=await outDoc.copyPages(srcDoc,[rotState[i].origIdx]);
      const origRot=pg.getRotation().angle;pg.setRotation(PDFLib.degrees((origRot+rotState[i].rotation)%360));outDoc.addPage(pg);
    }
    setP('rot-fill','rot-pct','rot-lbl',96,'Menyimpan...');const saved=await outDoc.save({useObjectStreams:true});setP('rot-fill','rot-pct','rot-lbl',100,'Selesai!');await delay(300);
    const outName=rotFile.name.replace(/\.pdf$/i,'')+'_edited.pdf';$('rot-out').innerHTML='';
    $('rot-out').appendChild(makeOutItem(outName,`${rotState.length} halaman · ${fmtB(saved.byteLength)}`,saved,'application/pdf',outName));
    $('rot-rsub').textContent=`${rotState.length} halaman`;$('prog-rot').classList.remove('show');$('res-rot').classList.add('show');$('btn-rot').disabled=false;
  }catch(e){showErr('err-rot','Gagal: '+e.message);$('prog-rot').classList.remove('show');$('btn-rot').disabled=false}
};
