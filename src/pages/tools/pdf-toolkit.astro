function hexToRgb(hex){const r=parseInt(hex.slice(1,3),16)/255,g=parseInt(hex.slice(3,5),16)/255,b=parseInt(hex.slice(5,7),16)/255;return{r,g,b}}

$('btn-wm').onclick=async()=>{
  if(!wmFile)return;
  $('btn-wm').disabled=true;$('prog-wm').classList.add('show');$('res-wm').classList.remove('show');hideErr('err-wm');
  const text=$('wm-text').value.trim()||'WATERMARK';const fontSize=parseInt($('wm-fs').value);
  const opacity=parseInt($('wm-op').value)/100;const rotDeg=parseInt($('wm-rot').value);const pos=$('wm-pos').value;
  const {r,g,b}=hexToRgb(wmColor);
  try{
    setP('wm-fill','wm-pct','wm-lbl',5,'Memuat PDF...');
    const buf=await wmFile.arrayBuffer();const pdfDoc=await PDFLib.PDFDocument.load(new Uint8Array(buf),{ignoreEncryption:true});
    const pages=pdfDoc.getPages();const N=pages.length;
    const font=await pdfDoc.embedFont(PDFLib.StandardFonts.HelveticaBold);
    for(let i=0;i<N;i++){
      setP('wm-fill','wm-pct','wm-lbl',10+Math.round((i/N)*85),`Halaman ${i+1}/${N}`);await tick();
      const page=pages[i];const {width,height}=page.getSize();
      const textWidth=font.widthOfTextAtSize(text,fontSize);
      const drawOpts={text,font,size:fontSize,color:PDFLib.rgb(r,g,b),opacity};
      if(pos==='tile'){
        const stepX=Math.max(textWidth*1.5,180),stepY=fontSize*4;
        const angleRad=rotDeg*Math.PI/180;
        for(let tx=-width;tx<width*2;tx+=stepX){for(let ty=-height;ty<height*2;ty+=stepY){
          page.drawText(text,{...drawOpts,x:tx,y:ty,rotate:PDFLib.degrees(rotDeg)})}}
      }else if(pos==='center'){
        page.drawText(text,{...drawOpts,x:(width-textWidth)/2,y:(height-fontSize)/2,rotate:PDFLib.degrees(rotDeg)});
      }else{
        const margin=24;const x_map={topleft:margin,topright:width-textWidth-margin,bottomleft:margin,bottomright:width-textWidth-margin};const y_map={topleft:height-fontSize-margin,topright:height-fontSize-margin,bottomleft:margin,bottomright:margin};
        page.drawText(text,{...drawOpts,x:x_map[pos]||margin,y:y_map[pos]||margin});
      }
    }
    setP('wm-fill','wm-pct','wm-lbl',97,'Menyimpan...');const saved=await pdfDoc.save({useObjectStreams:true});setP('wm-fill','wm-pct','wm-lbl',100,'Selesai!');await delay(300);
    const outName=wmFile.name.replace(/\.pdf$/i,'')+'_watermark.pdf';$('wm-out').innerHTML='';
    $('wm-out').appendChild(makeOutItem(outName,`${N} halaman · ${fmtB(saved.byteLength)}`,saved,'application/pdf',outName));
    $('wm-rsub').textContent=`Watermark "${text}" di ${N} halaman`;$('prog-wm').classList.remove('show');$('res-wm').classList.add('show');$('btn-wm').disabled=false;
  }catch(e){showErr('err-wm','Gagal: '+e.message);$('prog-wm').classList.remove('show');$('btn-wm').disabled=false}
};
