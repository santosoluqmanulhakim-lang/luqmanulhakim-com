let insMainBytes=null,insMainPageCount=0,insSrcBytes=null,insSrcPageCount=0,insQueue=[],insActiveTab='blank',insColor=[1,1,1];

setupDz('dz-ins-main','fi-ins-main',f=>loadInsMain(Array.isArray(f)?f[0]:f));
async function loadInsMain(f){
  if(!f?.name?.toLowerCase().endsWith('.pdf')){return}
  insMainBytes=null;insMainPageCount=0;
  const buf=await f.arrayBuffer();insMainBytes=new Uint8Array(buf);
  try{const d=await PDFLib.PDFDocument.load(insMainBytes,{ignoreEncryption:true});insMainPageCount=d.getPageCount()}catch(e){}
  $('fs-ins-main-name').textContent=f.name;$('fs-ins-main-info').textContent=`${insMainPageCount} halaman · ${fmtB(f.size)}`;$('fs-ins-main').classList.add('show');
  $('ins-total-hint').textContent=insMainPageCount;$('ins-pagenum').max=insMainPageCount;$('ins-controls').style.display='';$('btn-ins-add').disabled=false;hideErr('err-ins');
}
$('fs-ins-main-rm').onclick=()=>{insMainBytes=null;insMainPageCount=0;$('fs-ins-main').classList.remove('show');$('ins-controls').style.display='none';insQueue=[];renderInsQueue()};
setupDz('dz-ins-src','fi-ins-src',async f=>{
  f=Array.isArray(f)?f[0]:f;if(!f?.name?.toLowerCase().endsWith('.pdf'))return;
  const buf=await f.arrayBuffer();insSrcBytes=new Uint8Array(buf);
  try{const d=await PDFLib.PDFDocument.load(insSrcBytes,{ignoreEncryption:true});insSrcPageCount=d.getPageCount()}catch(e){}
  $('fs-ins-src-name').textContent=f.name;$('fs-ins-src-info').textContent=`${insSrcPageCount} halaman · ${fmtB(f.size)}`;$('fs-ins-src').classList.add('show');
});
$('fs-ins-src-rm').onclick=()=>{insSrcBytes=null;insSrcPageCount=0;$('fs-ins-src').classList.remove('show')};
document.querySelectorAll('.ins-tab').forEach(t=>{
  t.onclick=()=>{document.querySelectorAll('.ins-tab').forEach(x=>x.classList.remove('active'));t.classList.add('active');insActiveTab=t.dataset.t;
    document.querySelectorAll('.ins-tab-pane').forEach(x=>x.classList.remove('active'));$('ins-tab-'+t.dataset.t).classList.add('active')};
});
document.querySelectorAll('#ins-color-grid .color-opt').forEach(o=>{
  o.onclick=()=>{document.querySelectorAll('#ins-color-grid .color-opt').forEach(x=>x.classList.remove('selected'));o.classList.add('selected');insColor=o.dataset.color.split(',').map(Number)};
});
$('ins-pos').onchange=()=>{$('ins-pagenum-row').style.display=['before','after'].includes($('ins-pos').value)?'':'none'};
$('btn-ins-add').onclick=()=>{
  if(!insMainBytes)return;
  const pos=$('ins-pos').value,refPage=parseInt($('ins-pagenum').value)||1,count=parseInt($('ins-count').value)||1;
  if(['before','after'].includes(pos)&&(refPage<1||refPage>insMainPageCount)){showErr('err-ins','Nomor halaman tidak valid.');return}
  if(insActiveTab==='frompdf'&&!insSrcBytes){showErr('err-ins','Upload PDF sumber terlebih dahulu.');return}
  const entry={pos,refPage,count,type:insActiveTab,color:[...insColor],size:$('ins-size').value,srcPages:$('ins-src-pages').value.trim()};
  insQueue.push(entry);renderInsQueue();hideErr('err-ins');$('btn-ins-process').disabled=false;
};
function renderInsQueue(){
  const el=$('ins-queue-list'),empty=$('ins-queue-empty');
  el.innerHTML='';empty.style.display=insQueue.length?'none':'';
  insQueue.forEach((e,i)=>{
    const div=document.createElement('div');div.className='ins-queue-item';
    const pos_map={before:'Sebelum',after:'Setelah',start:'Di awal',end:'Di akhir'};
    const desc=`${pos_map[e.pos]||e.pos}${['before','after'].includes(e.pos)?' hal.'+e.refPage:''} · ${e.count}x · ${e.type==='blank'?'Kosong':'Dari PDF'}`;
    div.innerHTML=`<span class="ins-q-desc">${desc}</span><button class="ins-q-rm">✕</button>`;
    div.querySelector('.ins-q-rm').onclick=()=>{insQueue.splice(i,1);renderInsQueue();if(!insQueue.length)$('btn-ins-process').disabled=true};
    el.appendChild(div);
  });
}
function parsePageRangesIns(str,max){const pages=[];if(!str){for(let i=0;i<max;i++)pages.push(i);return pages}for(const p of str.split(',')){const m=p.trim().match(/^(\d+)(?:-(\d+))?$/);if(!m)continue;const from=+m[1]-1,to=m[2]?+m[2]-1:from;for(let i=Math.max(0,from);i<=Math.min(to,max-1);i++)pages.push(i)}return pages.length?pages:Array.from({length:max},(_,i)=>i)}
$('btn-ins-process').onclick=async()=>{
  if(!insMainBytes||!insQueue.length)return;
  $('btn-ins-process').disabled=true;$('prog-ins').classList.add('show');$('res-ins').classList.remove('show');hideErr('err-ins');
  try{
    setP('ins-fill','ins-pct','ins-lbl',5,'Memuat dokumen...');
    const outDoc=await PDFLib.PDFDocument.load(insMainBytes,{ignoreEncryption:true});
    // sort queue by resolved position descending so insertions don't shift indices
    const resolved=insQueue.map(e=>{let absPos;if(e.pos==='start')absPos=0;else if(e.pos==='end')absPos=outDoc.getPageCount();else if(e.pos==='before')absPos=e.refPage-1;else absPos=e.refPage;return{...e,absPos}}).sort((a,b)=>b.absPos-a.absPos);
    const total=resolved.length;let srcDocCache=null;
    for(let qi=0;qi<total;qi++){
      setP('ins-fill','ins-pct','ins-lbl',10+Math.round((qi/total)*80),`Sisipan ${qi+1}/${total}...`);await tick();
      const e=resolved[qi];
      if(e.type==='blank'){
        const sizes={A4:[595.28,841.89],A5:[419.53,595.28],LETTER:[612,792]};
        let pw,ph;if(e.size==='CUSTOM'){const pg=outDoc.getPage(Math.min(e.absPos,outDoc.getPageCount()-1));const sz=pg.getSize();pw=sz.width;ph=sz.height}else{[pw,ph]=sizes[e.size]||sizes.A4}
        const [r,g,b]=e.color;
        for(let k=0;k<e.count;k++){const pg=outDoc.insertPage(e.absPos,[pw,ph]);if(!(r===1&&g===1&&b===1))pg.drawRectangle({x:0,y:0,width:pw,height:ph,color:PDFLib.rgb(r,g,b)})}
      }else{
        if(!srcDocCache)srcDocCache=await PDFLib.PDFDocument.load(insSrcBytes,{ignoreEncryption:true});
        const pageIdxs=parsePageRangesIns(e.srcPages,srcDocCache.getPageCount());
        const copies=await outDoc.copyPages(srcDocCache,pageIdxs);
        for(let k=0;k<e.count;k++)for(let ci=0;ci<copies.length;ci++)outDoc.insertPage(e.absPos+k*copies.length+ci,copies[ci]);
      }
    }
    setP('ins-fill','ins-pct','ins-lbl',95,'Menyimpan...');const saved=await outDoc.save({useObjectStreams:true});setP('ins-fill','ins-pct','ins-lbl',100,'Selesai!');await delay(300);
    const outName='output_sisipan.pdf';$('ins-out').innerHTML='';
    $('ins-out').appendChild(makeOutItem(outName,`${outDoc.getPageCount()} halaman · ${fmtB(saved.byteLength)}`,saved,'application/pdf',outName));
    $('ins-rsub').textContent=`${insQueue.length} sisipan berhasil diterapkan`;$('prog-ins').classList.remove('show');$('res-ins').classList.add('show');$('btn-ins-process').disabled=false;
  }catch(e){showErr('err-ins','Gagal: '+e.message);$('prog-ins').classList.remove('show');$('btn-ins-process').disabled=false}
};
$('ins-reset').onclick=()=>{insMainBytes=null;insMainPageCount=0;insSrcBytes=null;insSrcPageCount=0;insQueue=[];$('fs-ins-main').classList.remove('show');$('fs-ins-src').classList.remove('show');$('ins-controls').style.display='none';$('prog-ins').classList.remove('show');$('res-ins').classList.remove('show');renderInsQueue();hideErr('err-ins')};

