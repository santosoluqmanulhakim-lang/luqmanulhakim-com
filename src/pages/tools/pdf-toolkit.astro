// ── NATIVE compress ──
async function compressNative(){
  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',5,'Membaca struktur PDF...');
  const buf=await cpdfFile.arrayBuffer();
  const pdfDoc=await PDFLib.PDFDocument.load(new Uint8Array(buf),{ignoreEncryption:true});
  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',30,'Memproses metadata & stream...');await tick();

  // Strip metadata
  if($('cpdf-native-meta').checked){
    pdfDoc.setTitle('');pdfDoc.setAuthor('');pdfDoc.setSubject('');
    pdfDoc.setKeywords([]);pdfDoc.setProducer('pdf-lib');pdfDoc.setCreator('PowerPDF');
  }

  // Remove embedded thumbnails (XRef objects named /Thumb)
  if($('cpdf-native-thumb').checked){
    try{
      const pages=pdfDoc.getPages();
      pages.forEach(pg=>{
        try{const dict=pg.node;if(dict.has&&dict.has(PDFLib.PDFName.of('Thumb')))dict.delete(PDFLib.PDFName.of('Thumb'))}catch(e){}
      });
    }catch(e){}
  }

  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',70,'Menyimpan dengan optimasi...');await tick();
  const useObjStream=$('cpdf-native-objstream').checked;
  const saved=await pdfDoc.save({useObjectStreams:useObjStream,addDefaultPage:false,updateFieldAppearances:false});
  return saved;
}

// ── RASTER compress ──
async function compressRaster(){
  const q=parseInt($('cpdf-q').value)/100,dpi=parseInt($('cpdf-d').value),scale=dpi/96;
  const whiteBg=$('cpdf-bg').checked,stripMeta=$('cpdf-meta').checked;
  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',3,'Membaca PDF...');
  const buf=await cpdfFile.arrayBuffer();
  const pdfjs=await pdfjsLib.getDocument({data:new Uint8Array(buf)}).promise;const N=pdfjs.numPages;
  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',8,`PDF dimuat — ${N} halaman`);
  const newDoc=await PDFLib.PDFDocument.create();const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');
  $('cpdf-thumbs').innerHTML='';const thumbs=[];
  for(let i=0;i<Math.min(N,24);i++){const d=document.createElement('div');d.className='th';d.innerHTML=`<span>${i+1}</span><div class="th-ck">✓</div>`;$('cpdf-thumbs').appendChild(d);thumbs.push(d)}
  for(let p=1;p<=N;p++){
    setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',8+Math.round((p/N)*82),`Render halaman ${p}/${N}`);$('cpdf-pinfo').textContent=`JPEG ${Math.round(q*100)}% @ ${dpi}dpi`;
    if(p-1<thumbs.length){if(p>1&&p-2<thumbs.length){thumbs[p-2].classList.remove('act');thumbs[p-2].classList.add('done')}thumbs[p-1].classList.add('act')}
    const page=await pdfjs.getPage(p);const vp=page.getViewport({scale});
    canvas.width=Math.round(vp.width);canvas.height=Math.round(vp.height);
    if(whiteBg){ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height)}else ctx.clearRect(0,0,canvas.width,canvas.height);
    await page.render({canvasContext:ctx,viewport:vp}).promise;
    if(p-1<thumbs.length){const tc=document.createElement('canvas');tc.width=52;tc.height=Math.round(canvas.height*(52/canvas.width));tc.getContext('2d').drawImage(canvas,0,0,tc.width,tc.height);thumbs[p-1].innerHTML='<div class="th-ck">✓</div>';thumbs[p-1].insertBefore(tc,thumbs[p-1].firstChild);thumbs[p-1].classList.add('done')}
    const dataUrl=canvas.toDataURL('image/jpeg',q);const jb=Uint8Array.from(atob(dataUrl.split(',')[1]),c=>c.charCodeAt(0));const img=await newDoc.embedJpg(jb);
    const origVp=page.getViewport({scale:1});const wPt=origVp.width*.75,hPt=origVp.height*.75;newDoc.addPage([wPt,hPt]).drawImage(img,{x:0,y:0,width:wPt,height:hPt});await tick();
  }
  setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',94,'Menyusun PDF...');
  if(stripMeta){newDoc.setTitle('');newDoc.setAuthor('');newDoc.setSubject('');newDoc.setKeywords([]);newDoc.setProducer('');newDoc.setCreator('')}
  return await newDoc.save({useObjectStreams:true});
}

// ── Main handler ──
$('btn-cpdf').onclick=async()=>{
  if(!cpdfFile)return;
  $('btn-cpdf').disabled=true;$('prog-cpdf').classList.add('show');$('res-cpdf').classList.remove('show');hideErr('err-cpdf');
  try{
    let saved;
    if(cpdfMethod==='native'){saved=await compressNative()}
    else{saved=await compressRaster()}
    cpdfBytes=saved;
    setP('cpdf-pfill','cpdf-ppct','cpdf-plbl',100,'Selesai!');await delay(300);
    const oSz=cpdfFile.size,nSz=saved.byteLength,pct=(oSz-nSz)/oSz*100;
    $('cpdf-ro').textContent=fmtB(oSz);$('cpdf-rn').textContent=fmtB(nSz);
    $('cpdf-rs').textContent=(pct>0?'-':'+')+Math.abs(pct).toFixed(1)+'%';$('cpdf-rs2').textContent=Math.abs(pct).toFixed(1)+'%';
    setTimeout(()=>$('cpdf-sbar').style.width=Math.max(0,Math.min(100,pct)).toFixed(1)+'%',100);
    const isNative=cpdfMethod==='native';
    $('cpdf-method-badge').textContent=isNative?'🧬 Metode Native — vektor & teks tetap utuh':'🖼 Metode Rasterisasi — halaman jadi gambar JPEG';
    if(isNative){
      $('cpdf-notice').textContent=pct<1?'ℹ️ Penghematan sangat kecil — PDF ini sudah teroptimasi. Struktur internalnya padat, tidak banyak yang bisa dibuang.':`✅ Hemat ${fmtB(Math.max(0,oSz-nSz))} — metadata, thumbnail, dan stream dioptimasi. Teks & vektor tetap bisa diedit.`;
      $('cpdf-notice').className='notice '+(pct<1?'':'ok');
    }else{
      $('cpdf-notice').textContent=pct<2?'⚠️ Penghematan kecil — PDF mungkin sudah padat. Coba mode Agresif.':`✅ Hemat ${fmtB(Math.max(0,oSz-nSz))} — halaman dirender ulang sebagai JPEG. PDF hasil tidak bisa diedit di software desain.`;
      $('cpdf-notice').className='notice '+(pct<2?'warn':'ok');
    }
    const suffix=isNative?'_native.pdf':'_compressed.pdf';
    $('cpdf-dl').href=URL.createObjectURL(new Blob([saved],{type:'application/pdf'}));$('cpdf-dl').download=cpdfFile.name.replace(/\.pdf$/i,'')+suffix;
    $('prog-cpdf').classList.remove('show');$('res-cpdf').classList.add('show');$('btn-cpdf').disabled=false;
  }catch(e){showErr('err-cpdf','Gagal: '+e.message);$('prog-cpdf').classList.remove('show');$('btn-cpdf').disabled=false}
};
