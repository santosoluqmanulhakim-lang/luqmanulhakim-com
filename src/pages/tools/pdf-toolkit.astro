$('btn-join').onclick=async()=>{
  if(!joinFiles.length)return;
  $('btn-join').disabled=true;$('prog-join').classList.add('show');$('res-join').classList.remove('show');hideErr('err-join');
  const addBlank=$('join-blank').checked,stripMeta=$('join-meta').checked;
  try{
    setP('jp-fill','jp-pct','jp-lbl',3,'Memulai...');const outDoc=await PDFLib.PDFDocument.create();let totalPages=0;
    for(let i=0;i<joinFiles.length;i++){
      setP('jp-fill','jp-pct','jp-lbl',5+Math.round((i/joinFiles.length)*88),`Proses file ${i+1}/${joinFiles.length}`);$('jp-info').textContent=joinFiles[i].file.name;await tick();
      const srcDoc=await PDFLib.PDFDocument.load(new Uint8Array(joinFiles[i].buf),{ignoreEncryption:true});const N=srcDoc.getPageCount();
      let idxs=[];const range=joinFiles[i].range.trim();
      if(!range){for(let j=0;j<N;j++)idxs.push(j)}else{for(const p of range.split(',')){const m=p.trim().match(/^(\d+)(?:-(\d+))?$/);if(!m)continue;const from=+m[1]-1,to=m[2]?+m[2]-1:from;for(let j=Math.max(0,from);j<=Math.min(to,N-1);j++)idxs.push(j)}if(!idxs.length)for(let j=0;j<N;j++)idxs.push(j)}
      if(addBlank&&i>0&&totalPages%2!==0){outDoc.addPage();totalPages++}
      const copied=await outDoc.copyPages(srcDoc,idxs);copied.forEach(p=>outDoc.addPage(p));totalPages+=idxs.length;await tick();
    }
    if(stripMeta){outDoc.setTitle('');outDoc.setAuthor('');outDoc.setSubject('');outDoc.setKeywords([]);outDoc.setProducer('');outDoc.setCreator('')}
    setP('jp-fill','jp-pct','jp-lbl',95,'Menyimpan...');const saved=await outDoc.save({useObjectStreams:true});joinResultBytes=saved;setP('jp-fill','jp-pct','jp-lbl',100,'Selesai!');await delay(300);
    const outName=joinFiles.length===2?joinFiles[0].file.name.replace(/\.pdf$/i,'')+'_joined.pdf':'merged.pdf';
    $('join-out').innerHTML='';$('join-out').appendChild(makeOutItem(outName,`${totalPages} halaman · ${fmtB(saved.byteLength)} · dari ${joinFiles.length} file`,saved,'application/pdf',outName));
    $('join-rsub').textContent=`${joinFiles.length} file → ${totalPages} hal · ${fmtB(saved.byteLength)}`;$('prog-join').classList.remove('show');$('res-join').classList.add('show');$('btn-join').disabled=false;
  }catch(e){showErr('err-join','Gagal: '+e.message);$('prog-join').classList.remove('show');$('btn-join').disabled=false}
};
$('join-prev').onclick=async()=>{if(!joinResultBytes)return;openModal('Preview PDF Gabungan');const pdf=await pdfjsLib.getDocument({data:new Uint8Array(joinResultBytes)}).promise;startModal(pdf)};
$('join-reset').onclick=()=>{joinFiles=[];joinResultBytes=null;renderJoinList();$('prog-join').classList.remove('show');$('res-join').classList.remove('show');hideErr('err-join')};

