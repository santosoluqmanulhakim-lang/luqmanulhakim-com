function renderJoinList(){
  const list=$('join-list'),empty=$('join-empty');
  if(!joinFiles.length){empty.style.display='';list.innerHTML='';$('join-opts').style.display='none';$('btn-join').style.display='none';return}
  empty.style.display='none';$('join-opts').style.display='';$('btn-join').style.display='flex';$('btn-join').disabled=false;
  list.innerHTML='';
  joinFiles.forEach((jf,i)=>{
    const item=document.createElement('div');item.className='ji';item.draggable=true;item.dataset.idx=i;
    item.innerHTML=`<span class="ji-drag">⠿</span><span style="font-size:18px">📄</span>
      <div class="ji-meta"><div class="ji-name">${jf.file.name}</div><div class="ji-info">${jf.pageCount} hal · ${fmtB(jf.file.size)}</div></div>
      <span style="font-size:11px;color:var(--ink3)">Hal:</span>
      <input class="ji-range" type="text" placeholder="semua" value="${jf.range}" title="Range halaman, cth: 1-3">
      <button class="ji-rm">✕</button>`;
    item.querySelector('.ji-range').onchange=e=>joinFiles[i].range=e.target.value.trim();
    item.querySelector('.ji-rm').onclick=()=>{joinFiles.splice(i,1);renderJoinList()};
